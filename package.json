{
  "name": "floatpaste",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "test": "node --test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preflight": "pnpm lint && pnpm build && pnpm test && pnpm test:rust",
    "install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win-pnpm.ps1 install",
    "dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win-pnpm.ps1 dev",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win-pnpm.ps1 build",
    "tauri:dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win-pnpm.ps1 tauri dev",
    "tauri:build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win-pnpm.ps1 tauri build",
    "test:rust:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win-cargo.ps1 test",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0"
  }
}
