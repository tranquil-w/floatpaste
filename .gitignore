# Rust 构建产物（workspace 根 target/）

# 应用本地运行数据
.floatpaste-data/
.release-accept/

# 日志文件
*.log

# 本地环境变量
.env
.env.*
!.env.example

# 编辑器与系统文件
# 仅忽略 VSCode 个人配置，保留 extensions.json 以共享推荐插件
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
tmp/
.claude/settings.local.json
.zcode/

# AI/工具临时产物
.playwright-mcp/
.brv/

# 临时产物（迭代计划、发版说明草稿等，不进 Git）
.artifacts/

# 图标生成脚本的本地产物
scripts/__pycache__/
crates/floatpaste-native/assets/_preview_pngs/
crates/floatpaste-native/assets/icon-tray.png
# 原生化冒烟测试工程（临时）
smoke/

# Cargo workspace 根 target
target/

# 本地 Inno 安装包编译产物
packaging/output/
.zcodeignore
