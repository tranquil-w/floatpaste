// 悬停预览：对齐原版 tooltip.html 的卡片（canvas-subtle 底、1px 边框、
// 6px 圆角、12/12 内边距、图片最大 560×420 居中、元信息分隔行）。
// 点击穿透与置顶不激活由 Rust 侧 Win32 处理；窗口尺寸由 Rust 度量后设置。
import { Theme, Metrics } from "theme.slint";

export struct TooltipMetaBadge {
    kind: int, // 0=类型徽章（带底色）1=尺寸 2=格式
    text: string,
}

// 正文单行：高度由 Rust 逐行实测（同排版引擎标尺），Slint 侧纯绑定渲染
export struct TooltipLine {
    text: string,
    height: length,
}

export component TooltipWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "FloatPaste · Tooltip";
    // Rust 在显示前按内容度量设置物理尺寸
    preferred-width: 200px;
    preferred-height: 80px;

    in-out property <bool> has-image: false;
    in-out property <image> image;
    in-out property <length> image-width: 0px;
    in-out property <length> image-height: 0px;
    in-out property <string> content-text;
    // 正文按源行拆行渲染（Slint Text 无 line-height，行距由
    // content-line-spacing 提供）；静态提示模式仍走 content-text 单行
    in-out property <[TooltipLine]> content-lines;
    // 行间距：Rust 测高时读取，保持与渲染同源
    out property <length> content-line-spacing: 4px;
    // 正文与分隔线之间的间距：Rust 测高时读取（计入窗口高）
    out property <length> content-bottom-gap: 6px;
    in-out property <[TooltipMetaBadge]> badges;
    in-out property <string> source-app;
    in-out property <string> time-text;
    // 静态提示模式（工具栏按钮等固定文案）：只显示一行文案，无元信息行
    in-out property <bool> simple-mode: false;

    // ── 卡片固定几何：Rust 定窗口尺寸时读取（单一事实来源，禁双边手抄）──
    // 横向：内容宽之外的总占用 = 左右 padding + 1px 边框×2
    out property <length> card-inset-h: 2 * Metrics.space-3 + 2px;
    // 元信息行的组成原子（分隔线 1px + 行上间距 + 徽章高）
    out property <length> meta-gap: 8px;
    out property <length> meta-badge-height: 18px;
    // 纵向：内容高之外的总占用 = 上下 padding + 分隔线 + 元信息行 + 边框×2
    out property <length> card-chrome-v:
        2 * Metrics.space-3 + 1px + meta-gap + meta-badge-height + 2px;
    // 静态模式的纵向占用 = 上下 padding + 边框×2（无分隔线与元信息行）
    out property <length> card-chrome-v-simple: 2 * Metrics.space-3 + 2px;

    // 排版度量标尺：Rust 据此设置窗口高度——度量与渲染同引擎，
    // 与内容 Text（13px + word-wrap）完全一致，窗口不会过矮裁掉尾部行
    callback measure-text(string, length) -> length;
    measure-text(text, width) => {
        text-ruler.text = text;
        text-ruler.width = width;
        text-ruler.height
    }

    // 自然宽度度量：不换行整串排开所需宽度（最宽段落），供 Rust 定卡片
    // 宽。与高度度量同引擎，取代原 GDI 估计（GDI 与 Slint 排版存在
    // 系统性偏差，靠安全系数硬凑）
    callback measure-natural-width(string) -> length;
    measure-natural-width(text) => {
        natural-ruler.text = text;
        natural-ruler.preferred-width
    }

    // 静态提示度量：无换行单行排版，宽度取自然宽；行高经 simple-line-height
    // 供 Rust 读（单行无折行，无需高度标尺回调）
    callback measure-simple-width(string) -> length;
    measure-simple-width(text) => {
        simple-ruler.text = text;
        simple-ruler.preferred-width
    }
    out property <length> simple-line-height: simple-ruler.height;

    // 卡片显式铺满窗口：窗口尺寸完全由 Rust 按内容度量设定（Window 直子
    // 不自动铺满，取首选尺寸会在四周露出透明区、透出背景窗口）
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.canvas-subtle;
        border-width: 1px;
        border-color: Theme.border-muted;
        border-radius: Metrics.radius-md;
        // 原版 box-shadow: 0 8px 24px rgba(shadow, 0.12)
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.shadow-color.with-alpha(0.12);

        VerticalLayout {
            padding-left: Metrics.space-3;
            padding-right: Metrics.space-3;
            padding-top: Metrics.space-3;
            padding-bottom: Metrics.space-3;

            if (root.has-image): Rectangle {
                height: root.image-height;
                // 原版 .tooltip-image-preview：8px 圆角裁剪
                border-radius: Metrics.radius-lg;
                clip: true;
                Image {
                    width: root.image-width;
                    height: root.image-height;
                    source: root.image;
                    image-fit: contain;
                }
            }
            // 静态提示：单行小字（与 simple-ruler 同字号同字重）
            if (root.simple-mode): Text {
                text: root.content-text;
                color: Theme.fg-default;
                font-size: Metrics.text-xs;
                font-weight: Metrics.weight-medium;
                wrap: word-wrap;
                min-width: 0px;
                height: root.simple-line-height;
                vertical-alignment: top;
                horizontal-stretch: 1;
            }
            // 条目正文：按源行拆行，行距由布局 spacing 提供，行高用
            // Rust 实测值（与窗口定高的度量同源）。stretch 归零：内容块
            // 保持实测高度，不参与剩余空间分配（否则度量余量会在正文与
            // 分隔线之间撑出空隙）
            if (!root.has-image && !root.simple-mode): VerticalLayout {
                vertical-stretch: 0;
                spacing: root.content-line-spacing;
                for line in root.content-lines: Text {
                    text: line.text;
                    color: Theme.fg-default;
                    font-size: Metrics.text-body;
                    wrap: word-wrap;
                    min-width: 0px;
                    height: line.height;
                    vertical-alignment: top;
                }
            }

            // 正文与分隔线之间的固定间距
            if (!root.has-image && !root.simple-mode): Rectangle {
                height: root.content-bottom-gap;
            }

            // 元信息行上方分隔线（对齐原版 border-top + margin/padding）；
            // 与正文之间由 content-bottom-gap 撑开
            if (!root.simple-mode): Rectangle {
                height: 1px;
                background: Theme.border-muted;
            }

            // ── 元信息行：类型与来源靠左成组，相对时间推到行尾 ──
            // 不设 alignment（禁 stretch，规则：start 会让占位失效）；
            // 除占位外全部 stretch=0，剩余宽度由占位独占、时间贴右
            if (!root.simple-mode): HorizontalLayout {
                // 显式定高（行上间距 + 徽章高）：度量安全余量由底部弹性
                // 占位吸收，不在此处变成不明空隙
                height: root.meta-gap + root.meta-badge-height;
                padding-top: root.meta-gap;
                spacing: Metrics.space-1_5;

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Metrics.space-1_5;
                    alignment: start;

                    for badge in root.badges: Rectangle {
                        height: root.meta-badge-height;
                        border-radius: Metrics.radius-sm;
                        background: badge.kind == 0 ? Theme.canvas-inset : transparent;
                        HorizontalLayout {
                            padding-left: badge.kind == 0 ? 5px : 0px;
                            padding-right: badge.kind == 0 ? 5px : 0px;
                            Text {
                                text: badge.text;
                                color: badge.kind == 0 ? Theme.fg-muted : Theme.fg-subtle;
                                font-size: Metrics.text-hint;
                                font-weight: Metrics.weight-medium;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    horizontal-stretch: 0;
                    text: root.source-app;
                    color: Theme.fg-muted;
                    font-size: Metrics.text-hint;
                    font-weight: Metrics.weight-medium;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    horizontal-stretch: 0;
                    text: root.time-text;
                    color: Theme.fg-subtle;
                    font-size: Metrics.text-hint;
                    vertical-alignment: center;
                }
            }

            // 底部弹性占位：窗口定高含 2px 度量安全余量（Rust 侧
            // HEIGHT_SAFETY），由这里确定性吸收，保证元信息行下方
            // 始终留有下边距
            if (!root.simple-mode): Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
            }
        }

        // 度量标尺（不可见不挡输入，排版属性与内容 Text 一致），
        // Rust 显示前经 measure-text 借它量内容高度
        text-ruler := Text {
            opacity: 0;
            x: 0;
            y: 0;
            width: 0px;
            text: "";
            font-size: Metrics.text-body;
            wrap: word-wrap;
        }

        // 自然宽度标尺：不换行排版，preferred-width 即最宽段落所需宽度
        natural-ruler := Text {
            opacity: 0;
            x: 0;
            y: 0;
            font-size: Metrics.text-body;
            wrap: no-wrap;
        }

        // 静态提示标尺：无换行单行（文案与字号与静态内容 Text 一致）
        simple-ruler := Text {
            opacity: 0;
            x: 0;
            y: 0;
            font-size: Metrics.text-xs;
            font-weight: Metrics.weight-medium;
            wrap: no-wrap;
            text: "";
        }
    }
}
