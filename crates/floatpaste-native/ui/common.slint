// 跨窗口共享的通用小组件。窗口各自的本地组件在复刻对齐时容易漏掉
// 修法（如 Kbd 的垂直下移只改了搜索窗），新增修复一律收敛到这里。
import { Theme, Metrics } from "theme.slint";

// 键位徽章（旧版 kbd：rounded border px-1 font-mono text-[10px] leading-3）
export component Kbd inherits Rectangle {
    in property <string> key;
    height: 15px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.canvas-default;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        // Consolas 无降部字形（Enter/Del/Esc/↑↓）墨迹中心比行盒中心
        // 高约 3px：顶部内边距把文本区整体下移，墨迹即与盒中心及
        // 右侧文案对齐
        padding-top: 4px;
        Text {
            text: root.key;
            color: Theme.fg-muted;
            font-size: 10px;
            font-family: "Consolas";
            vertical-alignment: center;
            // Slint 量出的文本首选宽与实际渲染墨迹有出入且默认左对齐，
            // 居中后框内左右留白才对称（旧版 px-1 两侧各 4px）
            horizontal-alignment: center;
            wrap: no-wrap;
        }
    }
}

// no-frame 内容窗（编辑/设置）的自绘标题栏：拖拽命中 + 窗控三键。
// 键位 46px 间距仿原生窗控布局；回调由宿主窗口接线，title-text 由
// 宿主给定（编辑窗含脏状态 ●）
export component WindowTitleBar inherits Rectangle {
    in property <string> title-text;
    callback drag-started();
    callback drag-moved();
    callback drag-finished();
    callback minimize-requested();
    callback max-toggle-requested();
    callback close-requested();

    height: 32px;
    background: transparent;
    Text {
        x: 12px;
        width: parent.width - 170px;
        height: parent.height;
        text: root.title-text;
        color: Theme.fg-default;
        font-size: Metrics.text-hint;
        vertical-alignment: center;
        overflow: elide;
    }
    // 拖拽命中区（声明在按钮之前 = 按钮点击优先）
    title-ta := TouchArea {
        mouse-cursor: default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.drag-started();
            }
            if (e.kind == PointerEventKind.up) {
                root.drag-finished();
            }
        }
        moved => { root.drag-moved(); }
    }
    // 最小化
    btn-min := Rectangle {
        x: parent.width - 138px;
        width: 46px;
        height: parent.height;
        background: btn-min-ta.has-hover ? Theme.canvas-subtle : transparent;
        btn-min-ta := TouchArea {
            mouse-cursor: default;
            clicked => { root.minimize-requested(); }
        }
        Path {
            x: (parent.width - 10px) / 2;
            y: (parent.height - 10px) / 2;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: Theme.fg-default;
            stroke-width: 1px;
            commands: "M 1 5 L 9 5";
        }
    }
    // 最大化切换
    btn-max := Rectangle {
        x: parent.width - 92px;
        width: 46px;
        height: parent.height;
        background: btn-max-ta.has-hover ? Theme.canvas-subtle : transparent;
        btn-max-ta := TouchArea {
            mouse-cursor: default;
            clicked => { root.max-toggle-requested(); }
        }
        Path {
            x: (parent.width - 10px) / 2;
            y: (parent.height - 10px) / 2;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: Theme.fg-default;
            stroke-width: 1px;
            commands: "M 1.5 1.5 L 8.5 1.5 L 8.5 8.5 L 1.5 8.5 Z";
        }
    }
    // 关闭（hover 红）
    btn-close := Rectangle {
        x: parent.width - 46px;
        width: 46px;
        height: parent.height;
        background: btn-close-ta.has-hover ? Theme.danger-subtle : transparent;
        btn-close-ta := TouchArea {
            mouse-cursor: default;
            clicked => { root.close-requested(); }
        }
        Path {
            x: (parent.width - 10px) / 2;
            y: (parent.height - 10px) / 2;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: Theme.fg-default;
            stroke-width: 1px;
            commands: "M 1 1 L 9 9 M 9 1 L 1 9";
        }
    }
}
