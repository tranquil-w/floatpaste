// 跨窗口共享的通用小组件。窗口各自的本地组件在复刻对齐时容易漏掉
// 修法（如 Kbd 的垂直下移只改了搜索窗），新增修复一律收敛到这里。
import { Theme, Metrics } from "theme.slint";

// 键位徽章（旧版 kbd：rounded border px-1 font-mono text-[10px] leading-3）
export component Kbd inherits Rectangle {
    in property <string> key;
    height: 15px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.canvas-default;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        // Consolas 无降部字形（Enter/Del/Esc/↑↓）墨迹中心比行盒中心
        // 高约 3px：顶部内边距把文本区整体下移，墨迹即与盒中心及
        // 右侧文案对齐
        padding-top: 4px;
        Text {
            text: root.key;
            color: Theme.fg-muted;
            font-size: 10px;
            font-family: "Consolas";
            vertical-alignment: center;
            // Slint 量出的文本首选宽与实际渲染墨迹有出入且默认左对齐，
            // 居中后框内左右留白才对称（旧版 px-1 两侧各 4px）
            horizontal-alignment: center;
            wrap: no-wrap;
        }
    }
}

// no-frame 内容窗（编辑/设置）的自绘标题栏：应用图标 + 拖拽命中 +
// 窗控三键。键位 46px 间距仿原生窗控布局；回调由宿主窗口接线，
// title-text 由宿主给定（编辑窗含脏状态 ●），maximized 由宿主在
// 切换后回写（还原态图标随之切换）
export component WindowTitleBar inherits Rectangle {
    in property <string> title-text;
    in property <bool> maximized: false;
    callback drag-started();
    callback drag-moved();
    callback drag-finished();
    callback minimize-requested();
    callback max-toggle-requested();
    callback close-requested();

    height: 32px;
    background: transparent;
    Image {
        x: 10px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        // 32px 小尺寸规格源图（scripts/make_icon.py 产出）。512 源图
        // 直缩 32 倍发糊；16px 又在 125%/150% DPI 下要放大
        source: @image-url("titlebar-icon.png");
    }
    Text {
        x: 34px;
        width: parent.width - 180px;
        height: parent.height;
        text: root.title-text;
        color: Theme.fg-default;
        font-size: Metrics.text-hint;
        vertical-alignment: center;
        overflow: elide;
    }
    // 拖拽命中区（声明在按钮之前 = 按钮点击优先）
    title-ta := TouchArea {
        mouse-cursor: default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.drag-started();
            }
            if (e.kind == PointerEventKind.up) {
                root.drag-finished();
            }
        }
        moved => { root.drag-moved(); }
    }
    // 最小化
    btn-min := Rectangle {
        x: parent.width - 138px;
        width: 46px;
        height: parent.height;
        background: btn-min-ta.has-hover ? Theme.canvas-subtle : transparent;
        btn-min-ta := TouchArea {
            mouse-cursor: default;
            clicked => { root.minimize-requested(); }
        }
        Path {
            x: (parent.width - 12px) / 2;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            stroke: Theme.fg-default;
            stroke-width: 1px;
            // 线心 6.5：整数像素覆盖 6..7，100% DPI 下单行实线；
            // 6.0 会跨像素糊成两行半透明灰线。线宽仿原生：通栏全宽
            commands: "M 0 6.5 L 12 6.5";
        }
    }
    // 最大化/还原切换（最大化后显示原生样式的双窗格还原图标）
    btn-max := Rectangle {
        x: parent.width - 92px;
        width: 46px;
        height: parent.height;
        background: btn-max-ta.has-hover ? Theme.canvas-subtle : transparent;
        btn-max-ta := TouchArea {
            mouse-cursor: default;
            clicked => { root.max-toggle-requested(); }
        }
        Path {
            x: (parent.width - 12px) / 2;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            stroke: Theme.fg-default;
            stroke-width: 1px;
            commands: !root.maximized
                ? "M 1 1 L 11 1 L 11 11 L 1 11 Z"
                // 前窗格整框 + 后窗格仅露出未被前窗格描边遮住的部分
                // （前窗格无填充、遮不住线，被遮线段必须省略）
                : "M 1 4 L 8 4 L 8 11 L 1 11 Z"
                + " M 4 4 L 4 1 L 11 1 L 11 8 L 9 8";
        }
    }
    // 关闭（hover 红）
    btn-close := Rectangle {
        x: parent.width - 46px;
        width: 46px;
        height: parent.height;
        background: btn-close-ta.has-hover ? Theme.danger-subtle : transparent;
        btn-close-ta := TouchArea {
            mouse-cursor: default;
            clicked => { root.close-requested(); }
        }
        Path {
            x: (parent.width - 12px) / 2;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            stroke: Theme.fg-default;
            stroke-width: 1px;
            // X 比最大化方块略大（11 vs 10），仿原生窗控比例
            commands: "M 0.5 0.5 L 11.5 11.5 M 11.5 0.5 L 0.5 11.5";
        }
    }
}
