// 语义主题 token：由 Rust 侧（floatpaste-core::theme 派生结果）写入。
// 键集与前端 --pg-* CSS 变量一一对应，组件只消费这一层。
export global Theme {
    // 解析后的明暗模式：UI 结构按模式分叉的判定信号
    // （速贴：浅色层灰卡白 / 深色近黑面板+透明行）
    in-out property <bool> is-dark;
    // 画布
    in-out property <color> canvas-default;
    in-out property <color> canvas-subtle;
    in-out property <color> canvas-inset;
    // 卡片/浮起面实色：层级语言 =
    // 层底（canvas）比卡片深一档，卡片靠亮度差 + 描边 + 投影浮起
    in-out property <color> surface;
    // 承托卡片的层底（速贴面板）：浅取 canvas-subtle 灰、深取
    // canvas 近黑（深色层底变亮整体发灰）；浮起卡浮在这层上
    in-out property <color> card-layer;
    // 浮起卡面（速贴行卡）：浅取 surface 纯白、深取 canvas-subtle
    // 微亮（深色 surface 亮灰卡发灰被否）
    in-out property <color> card-face;
    // 材质窗统一玻璃层：可激活窗（搜索/编辑/设置）的窗根直铺这层
    // （单层，各窗一致），明暗同 alpha（深压噪点、浅压白雾），rgb 取
    // surface 纯白（浅）/canvas（深）。前景文字与卡片坐其上。材质不可
    // 用的窗口回退 canvas-default 不透明底；速贴不走材质（无焦点窗拿
    // 不到 Acrylic 模糊，面板底自绘烘焙，见 no-focus-picker.md 坑十一）
    in-out property <color> material-layer;
    // 设置层填充（WinUI Layer 同构）：白墨半透明叠在玻璃面上，
    // 设置卡与目录选中项共用。亮度增量恒定、材质随玻璃透底；与预设
    // 无关的固定白叠层（同 Motion 常量性质），不经 Rust token 派生
    out property <color> layer-fill: is-dark
        ? #FFFFFF.with-alpha(0.05)
        : #FFFFFF.with-alpha(0.70);


    // 前景
    in-out property <color> fg-default;
    in-out property <color> fg-muted;
    in-out property <color> fg-subtle;
    in-out property <color> fg-on-emphasis;

    // 强调
    in-out property <color> accent-fg;
    in-out property <color> accent-emphasis;
    in-out property <color> accent-hover;
    in-out property <color> accent-subtle; // rgba 合成后的半透明色
    // 选中行/选中项中性底：正文墨色低 alpha 半透明叠层
    // （浅 0.12 压暗 / 深 0.16 提亮），选中感由恒定亮度偏移 + 左缘 3px 强调条承载
    in-out property <color> selected-bg;

    // 边框
    in-out property <color> border-default;
    in-out property <color> border-window;
    in-out property <color> border-muted;
    in-out property <color> border-subtle;
    in-out property <color> border-accent;

    // 状态色（前景 + 半透明底）
    in-out property <color> success-fg;
    in-out property <color> success-subtle;
    in-out property <color> danger-fg;
    in-out property <color> danger-subtle;
    in-out property <color> warning-fg;
    in-out property <color> warning-subtle;
    in-out property <color> warning-emphasis;
    in-out property <color> done-fg;
    in-out property <color> done-subtle;

    // 收藏星标 / 阴影
    in-out property <color> favorite;
    in-out property <color> shadow-color;

    // 文本选区 / IME 组合词高亮（旧版 ::selection）
    in-out property <color> selection-fg;
    in-out property <color> selection-bg;
}

// 语义尺寸 token：刻度与原版 Tailwind 类一一对应（注释标明出处）。
// 组件不得散写魔法数——新尺寸先到这里对号入座；仅一次性用途的
// 结构尺寸（如头部高度、预览最大高）允许留在组件内。
export global Metrics {
    // 圆角：rounded-lg / rounded-md / rounded-[4px] / rounded-full
    out property <length> radius-lg: 8px;
    out property <length> radius-md: 6px;
    out property <length> radius-sm: 4px;
    out property <length> radius-pill: 999px;

    // 间距：gap-1 / py-1.5 / py-2 / px-3
    out property <length> space-1: 4px;
    out property <length> space-1_5: 6px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;

    // 字级：text-[9px] / text-[10px] / text-[11px] / text-xs / text-[13px] / text-sm
    out property <length> text-micro: 9px;
    out property <length> text-meta: 10px;
    out property <length> text-hint: 11px;
    out property <length> text-xs: 12px;
    out property <length> text-body: 13px;
    out property <length> text-sm: 14px;

    // 字重：font-normal / font-medium / font-semibold / font-bold
    out property <int> weight-normal: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
}

// 动效 token：时长与曲线的单一来源，animate 一律引用，不散写字面量。
// 频率纪律——速贴/搜索窗的呼出、键盘导航选中、粘贴回车是每日百次级
// 高频交互，除既有进场语言外不加重入动画；动效只服务 hover/按压
// 反馈、浮层与横幅进场。
export global Motion {
    // 颜色类反馈：hover 底、描边、徽章底、按压渐变、tooltip 渐显
    out property <duration> dur-color: 120ms;
    // 浮层与面板进场：标签面板、操作条、横幅收放、滑入
    out property <duration> dur-enter: 150ms;
    // 曲线统一 ease-out：快起缓收，反馈即时；状态切换颜色过渡亦用之
    out property <easing> ease: ease-out;
}

// 自绘柔影：软件渲染器的 draw_box_shadow 是空实现（slint 1.18.1 内
// // TODO），drop-shadow-* 声明被静默忽略——一切投影需求统一改用本
// 组件。同心外扩的实心圆角层堆叠出线性衰减羽化（近似高斯轮廓）：
// 层 k 覆盖轮廓外 0..k×step，距边缘 d 处的叠加层数 ∝ extent-d，近
// 边浓、向外线性变淡。层必须用实心填充（描边环各盖一圈，叠不出
// 衰减梯度）；因此**只能安放在不透明卡面的下层**——卡中心区域
// layers 层全叠（≈alpha 的墨色），透明卡面挡不住它，会变成盖满
// 整卡的均匀染色而非投影（安放形态：不透明卡的前置兄弟，或透明包
// 裹层内先声明的元素；卡片自身带 clip:true 时不可作卡内子元素，外
// 扩环带会被裁掉）。offset-y 把各层轮廓整体下移：上缘羽化范围
// extent-offset-y、下缘 extent+offset-y（超出 extent 的上缘不出影）
export component SoftShadow inherits Rectangle {
    in property <int> layers: 8;        // 层数；总羽化范围 extent = layers × step
    in property <length> step: 1px;     // 层距（羽化粒度）
    in property <length> offset-y: 2px;
    in property <length> radius: 12px;  // 对齐卡片圆角，各层同心长大
    in property <float> alpha: 0.12;    // 轮廓边缘处的合成峰值
    background: transparent;
    for layer[i] in root.layers: Rectangle {
        property <length> e: (i + 1) * root.step;
        x: -e;
        y: -e + root.offset-y;
        width: parent.width + 2 * e;
        height: parent.height + 2 * e;
        border-radius: root.radius + e;
        background: Theme.shadow-color.with-alpha(root.alpha / root.layers);
    }
}
