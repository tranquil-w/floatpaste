// 编辑窗口：条目信息、标签、正文工具栏与状态栏分区。
// no-frame 窗 + 自绘标题栏（任务栏可见、可缩放、800×600 起 min 400×300，
// 停屏常驻不销毁重建）。会话与数据由 Rust 接管：
// - 文本条目：多行编辑 + Ctrl+S 保存 + 未保存关闭确认 + 两段式删除
// - 图片/文件条目：只读预览（大图 contain / 路径列表，可系统程序打开）
// - 标签：Notion 式多选面板——行内 chips（× 删除）+「添加标签」入口，
//   面板内搜索/勾选已选/创建；回车采纳、Tab 补全、上下键导航（滚动
//   跟随）、Backspace 空输入删末位、Esc 分层退出（清输入→关面板→关窗）
// - 键盘：窗口级 capture 先于输入框（对齐旧版 window keydown capture）
import { Theme, Metrics, Motion, SoftShadow } from "theme.slint";
import { Kbd, WindowTitleBar } from "common.slint";

// 标签建议项：0=match（既有命中）1=create（新建）2=exists（已添加）
export struct EditorTagSuggestion {
    kind: int,
    name: string,
    count-text: string,
}

// 底部状态栏保存按钮（文本条目专用）：
// 干净状态：轻量状态徽章（微边框 + 对勾 + 浅灰文字）；
// 脏状态：高亮主按钮（Theme.accent-emphasis + 纯白加粗文字）。
component SaveButton inherits Rectangle {
    in property <bool> is-dirty: false;
    callback clicked();
    callback hint(length, length);
    callback hint-left();

    height: 24px;
    width: save-row.preferred-width + 16px;
    border-radius: Metrics.radius-md;
    border-width: 1px;
    border-color: root.is-dirty ? transparent : (save-ta.has-hover ? Theme.border-default : Theme.border-subtle);
    background: root.is-dirty
        ? (save-ta.has-hover ? Theme.accent-hover : Theme.accent-emphasis)
        : (save-ta.has-hover ? Theme.hover-bg : transparent);
    opacity: save-ta.pressed ? 0.85 : 1.0;
    animate background { duration: Motion.dur-color; easing: Motion.ease; }
    animate border-color { duration: Motion.dur-color; easing: Motion.ease; }

    save-ta := TouchArea {
        mouse-cursor: root.is-dirty ? pointer : default;
        clicked => {
            if (root.is-dirty) {
                root.clicked();
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                root.hint(root.absolute-position.x, root.absolute-position.y + root.height + 4px);
            } else {
                root.hint-left();
            }
        }
    }

    save-row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        alignment: center;
        if (!root.is-dirty): Path {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            stroke: Theme.fg-subtle;
            stroke-width: 2.2px;
            commands: "M 4 12.5 L 9.5 18 L 20 6.5";
        }
        Text {
            text: root.is-dirty ? "保存" : "已保存";
            color: root.is-dirty ? Theme.fg-on-emphasis : Theme.fg-subtle;
            font-size: Metrics.text-xs;
            font-weight: root.is-dirty ? Metrics.weight-medium : Metrics.weight-normal;
            vertical-alignment: center;
        }
    }
}

// 两段式删除按钮（旧版 actionButtonDanger 的编辑器变体）
component DeleteButton inherits Rectangle {
    in property <bool> armed;
    callback clicked();
    callback hint(length, length);
    callback hint-left();

    height: 24px;
    width: armed ? 68px : 24px;
    border-radius: Metrics.radius-md;
    opacity: del-ta.pressed ? 0.85 : 1.0;
    background: armed ? Theme.danger-subtle
        : (del-ta.has-hover ? Theme.danger-subtle : transparent);
    animate background { duration: Motion.dur-color; easing: Motion.ease; }
    animate width { duration: Motion.dur-enter; easing: Motion.ease; }

    del-ta := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover) {
                root.hint(root.absolute-position.x, root.absolute-position.y + root.height + 4px);
            } else {
                root.hint-left();
            }
        }
    }

    if (root.armed): HorizontalLayout {
        alignment: center;
        Text {
            text: "确认删除";
            color: Theme.danger-fg;
            font-size: Metrics.text-xs;
            font-weight: Metrics.weight-medium;
            vertical-alignment: center;
        }
    }
    if (!root.armed): Path {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: del-ta.has-hover ? Theme.danger-fg : Theme.fg-muted;
        // Slint 描边不随视框缩放：1.8 @24 → 16px 显示折算 1.2px
        stroke-width: 1.2px;
        commands: "M 4 7 L 20 7 M 9.5 4.75 L 14.5 4.75 L 14.5 7 L 9.5 7 Z M 6.5 7 L 7.3 19.25 L 16.7 19.25 L 17.5 7 M 10 10.5 L 10 16.5 M 14 10.5 L 14 16.5";
    }
}

// 仅用于本窗口的轻量工具键；焦点框和 Enter/空格支持与指针同一路径。
component EditorTool inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> tip: root.label;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> available: true;
    callback clicked();
    callback hint(string, length, length);
    callback hint-left();
    height: 28px;
    width: root.primary ? 64px : root.icon != "" ? 28px : tool-label.preferred-width + 16px;
    horizontal-stretch: 0;
    border-radius: Metrics.radius-md;
    opacity: tool-ta.pressed && root.available ? 0.85 : 1.0;
    background: root.primary ? (root.available ? Theme.accent-emphasis : Theme.hover-bg)
        : tool-ta.has-hover || tool-focus.has-focus || root.active ? Theme.hover-bg : transparent;
    border-width: 1px;
    border-color: tool-focus.has-focus ? Theme.border-accent : transparent;
    animate background { duration: Motion.dur-color; easing: Motion.ease; }
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.available;
    accessible-action-default => { if (root.available) { root.clicked(); } }
    tool-label := Text {
        visible: root.icon == "";
        text: root.label;
        color: root.primary && root.available ? Theme.fg-on-emphasis : root.active ? Theme.fg-default : Theme.fg-muted;
        font-size: Metrics.text-xs;
        font-weight: root.primary ? Metrics.weight-medium : Metrics.weight-normal;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (root.icon != ""): Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.active ? Theme.fg-default : Theme.fg-muted;
        stroke-width: 1.3px;
    }
    tool-focus := FocusScope {
        enabled: root.available;
        width: 100%;
        height: 100%;
        key-pressed(e) => {
            if (root.available && (e.text == Key.Return || e.text == " ")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        tool-ta := TouchArea {
            mouse-cursor: root.available ? pointer : default;
            clicked => { if (root.available) { root.clicked(); } }
            changed has-hover => {
                if (self.has-hover) {
                    root.hint(root.tip, root.absolute-position.x + root.width / 2, root.absolute-position.y + root.height + 4px);
                } else { root.hint-left(); }
            }
        }
    }
}

export component EditorWindow inherits Window {
    no-frame: true;
    icon: @image-url("app-icon.png");
    min-width: 400px;
    min-height: 300px;
    preferred-width: 800px;
    preferred-height: 600px;
    // no-frame 后窗体矩形透明，全部观感由 panel 圆角面板绘制（与速贴
    // 卡片/搜索面板同构）；材质（Mica）挂载成功时面板半透明透出
    // backdrop，否则不透明回退
    background: transparent;
    in property <bool> material-active: false;
    // 最大化态（Rust 在切换后回写）：标题栏据此显示还原图标
    in property <bool> is-maximized: false;

    // 自绘标题栏回调：拖拽手势与窗控（最小化/最大化切换/关闭）
    callback drag-started();
    callback drag-moved();
    callback drag-finished();
    callback minimize-requested();
    callback max-toggle-requested();

    // ── 会话与数据（Rust 接管）──
    in-out property <bool> has-session: false;
    in-out property <bool> item-missing: false;
    in-out property <bool> load-failed: false;
    in-out property <bool> is-text: false;
    // 引导键帽（"编辑内容"会话键，含 "+" 分隔符），Rust 按当前设置注入
    in-out property <[string]> edit-key-parts;
    in-out property <string> meta-source;
    in-out property <string> meta-time;
    in-out property <string> meta-extra;
    in-out property <int> char-count: 0;
    // draft 文本的 UTF-8 字节长度：Slint 侧无字节长度内建，而
    // set-selection-offsets 按字节偏移取位（char-count 是字符数，中文
    // 文本用它会落在字符中间），置尾光标由 Rust 维护此值
    in-out property <int> draft-byte-len: 0;
    in-out property <string> draft-text;
    in-out property <string> saved-text;
    in property <bool> has-html: false;
    // 旧版 store：isDirty = draft !== saved
    in-out property <bool> is-dirty: root.draft-text != root.saved-text;
    in-out property <bool> has-image: false;
    in-out property <bool> image-loading: false;
    in-out property <bool> image-failed: false;
    in property <image> image-preview;
    // 图片存储文件的绝对路径（Rust 侧由库内相对路径解析而来）：
    // 预览区「打开」按钮用（系统查看器）；空表示图片文件缺失
    in-out property <string> image-path;
    in-out property <[string]> file-paths;
    // 光标行列（1 起，Rust 按 draft 文本计算写回）
    in-out property <int> cursor-line: 1;
    in-out property <int> cursor-col: 1;
    in-out property <[string]> tags;
    in-out property <[EditorTagSuggestion]> tag-suggestions;
    in-out property <string> tag-input-text;
    in-out property <int> tag-highlight: 0;
    in-out property <string> notice-text;
    in-out property <string> error-text;
    in-out property <bool> delete-armed: false;
    in-out property <bool> close-confirm-open: false;
    // 每次载入条目自增：驱动编辑区 changed 重新聚焦（init 只在首次
    // 实例化时执行，同窗口第二次打开不会再次触发）
    in-out property <int> session-seq: 0;

    // 标签面板开关（Notion 式：添加/搜索/创建在面板内完成）。显式状态
    // 而非绑定表达式：打开由「+ 添加」触发，关闭由 Esc（tag-escape）或
    // 搜索框失焦驱动
    in-out property <bool> tag-open: false;
    // 高亮收拢到合法范围（对齐 activeIndex = min(highlight, len-1)）
    in-out property <int> tag-active:
        Math.min(root.tag-highlight, root.tag-suggestions.length - 1);

    // 显示偏好只存在当前窗口内，不写配置、不改变正文。
    in-out property <int> focus-body-seq: 0;
    changed tag-open => {
        if (!root.tag-open) {
            root.focus-root-scope();
            root.focus-body-seq += 1;
        }
    }
    in-out property <bool> wrap-text: true;
    in-out property <bool> monospace: false;
    in-out property <int> undo-seq: 0;
    in-out property <int> redo-seq: 0;
    in-out property <int> select-all-seq: 0;
    in-out property <int> wrap-toggle-seq: 0;

    // ── 回调（Rust 接管）──
    callback text-edited(string);
    callback editor-cursor-moved(int); // 光标移动（UTF-8 byte offset），Rust 算行列
    callback open-externally(string);  // 系统默认程序打开路径
    callback open-file-path-at(int);   // 按索引打开文件条目路径
    callback button-hint(string, length, length); // 按钮 tooltip（悬浮气泡 simple 模式）
    callback button-hint-left();
    callback save-requested();
    callback retry-clicked();
    callback request-close();
    callback close-discard();
    callback close-save();
    callback confirm-cancel();
    callback delete-requested();
    callback tag-input-changed(string);
    callback tag-commit-add();        // 回车：采纳高亮建议或按输入添加
    callback tag-adopt(int);          // 点击建议行直接采纳
    callback tag-complete();          // Tab：建议文本补全进输入框
    callback tag-remove(int);         // × 移除指定标签
    callback tag-remove-last();       // 空输入 Backspace 移除末位标签
    callback tag-escape();            // 标签输入本地消费 Esc（清空输入）

    // 非文本条目（图片/文件）没有输入框可聚焦，把焦点挂在窗口级
    // FocusScope 上，否则窗口键盘（Esc/Ctrl+S）无人接收；
    // 文本条目的输入框聚焦由编辑区 init 承担（if 内不可外部寻址）
    public function focus-root-scope() {
        root-scope.focus();
    }

    // 打开标签面板并聚焦搜索框（「+ 添加」chip / 标签行点击触发）。
    // 面板常驻实例化，可立即寻址聚焦
    public function open-tag-panel() {
        root.tag-open = true;
        panel-input.focus();
    }

    // 窗口级键盘（capture 先于输入框；对齐旧版 window keydown capture）。
    // 窗口直接子元素不自动铺满，必须显式全屏（对齐旧版 h-screen w-screen）
    // 圆角面板：no-frame 窗的可见形态。DWM 圆角（apply_dwm_rounded_corners）
    // 裁窗体轮廓，面板圆角与窗底同色系，边缘由 DWM 阴影勾勒
    panel := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        // Mica 常驻内容窗 + 近实心层：正文脚下不透材质（PowerRename
        // 同款），材质感留给层下的 Mica 底
        background: root.material-active ? Theme.material-layer : Theme.canvas-default;
        clip: true;

    root-scope := FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            if (root.close-confirm-open) {
                if (event.text == Key.Escape) {
                    root.confirm-cancel();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.close-save();
                    return accept;
                }
                return reject; // Tab 走默认对话框焦点穿梭
            }
            if (event.text == Key.Escape) {
                // 标签面板的分层退出（Esc 先关面板/清输入，再关窗口）：
                // 面板开着时 Esc 交给 tag-escape（Rust 侧清输入或关面板）
                if (panel-input.has-focus
                    && (root.tag-input-text != "" || root.tag-open))
                {
                    root.tag-escape();
                    return accept;
                }
                root.request-close();
                return accept;
            }
            if ((event.modifiers.control || event.modifiers.meta)
                && (event.text == "s" || event.text == "S"))
            {
                root.save-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // ── 自绘标题栏（共享组件：拖拽 + 窗控按钮）──
            WindowTitleBar {
                maximized: root.is-maximized;
                is-dirty: root.has-session && root.is-dirty;
                title-text: "FloatPaste · 编辑";
                drag-started => root.drag-started();
                drag-moved => root.drag-moved();
                drag-finished => root.drag-finished();
                minimize-requested => root.minimize-requested();
                max-toggle-requested => root.max-toggle-requested();
                close-requested => root.request-close();
            }
            // ── 顶部通知条（成功 3 秒自动消失，由 Rust 计时）──
            // 高度收放而非 if 条件实例化：条件实例化无法做进场动画；
            // visible 又不参与布局计算（隐藏仍占位），0 高 + clip +
            // opacity 联动即「展开浮现/收起消失」
            Rectangle {
                height: root.notice-text != "" ? 36px : 0px;
                animate height { duration: Motion.dur-enter; easing: Motion.ease; }
                opacity: root.notice-text != "" ? 1.0 : 0.0;
                animate opacity { duration: Motion.dur-enter; easing: Motion.ease; }
                clip: true;
                background: Theme.success-subtle;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    Text {
                        text: root.notice-text;
                        color: Theme.success-fg;
                        font-size: Metrics.text-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            // ── 错误条（持续到下一次动作）──
            Rectangle {
                height: root.error-text != "" ? 36px : 0px;
                animate height { duration: Motion.dur-enter; easing: Motion.ease; }
                opacity: root.error-text != "" ? 1.0 : 0.0;
                animate opacity { duration: Motion.dur-enter; easing: Motion.ease; }
                clip: true;
                background: Theme.danger-subtle;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    Text {
                        text: root.error-text;
                        color: Theme.danger-fg;
                        font-size: Metrics.text-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // ── 主区（旧版 main flex-1：吃掉底栏以外的全部剩余高度）──
            Rectangle {
                vertical-stretch: 1;
                background: Theme.canvas-subtle;
                clip: true;

                // 无会话：引导态
                if (!root.has-session): VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: 12px;
                    Path {
                        width: 40px;
                        height: 40px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke: Theme.fg-subtle;
                        // 1.5 @24 → 40px 显示折算 2.5px
                        stroke-width: 2.5px;
                        commands: "M 8 3 L 16 3 A 1 1 0 0 1 17 4 L 17 7 L 7 7 L 7 4 A 1 1 0 0 1 8 3 Z M 16 5 L 18 5 A 2 2 0 0 1 20 7 L 20 19 A 2 2 0 0 1 18 21 L 6 21 A 2 2 0 0 1 4 19 L 4 7 A 2 2 0 0 1 6 5 L 8 5";
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "选择一个条目开始查看或编辑";
                            color: Theme.fg-muted;
                            font-size: Metrics.text-sm;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "在速贴或搜索窗口中选中条目后按";
                                color: Theme.fg-subtle;
                                font-size: Metrics.text-xs;
                                vertical-alignment: center;
                            }
                            for part in root.edit-key-parts: VerticalLayout {
                                alignment: center;
                                if (part == "+"): Text {
                                    text: part;
                                    color: Theme.fg-subtle;
                                    font-size: Metrics.text-xs;
                                    vertical-alignment: center;
                                }
                                if (part != "+"): Kbd {
                                    key: part == "Super" ? "Win" : part;
                                }
                            }
                        }
                    }
                }

                // 条目缺失与读取失败分别呈现，读取失败可在当前会话重试。
                if (root.has-session && (root.item-missing || root.load-failed)): VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: root.item-missing ? "未找到对应条目" : "条目加载失败";
                        color: Theme.fg-muted;
                        font-size: Metrics.text-sm;
                        horizontal-alignment: center;
                    }
                    if (root.load-failed): HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 88px;
                            height: 32px;
                            border-radius: Metrics.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-default;
                            background: retry-ta.has-hover ? Theme.hover-bg : transparent;
                            Text {
                                text: "重新加载";
                                color: Theme.fg-default;
                                font-size: Metrics.text-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            retry-ta := TouchArea {
                                clicked => { root.retry-clicked(); }
                            }
                        }
                    }
                }

                // 正文面板只留小幅外边距；标签属于当前条目，直接融入面板上沿。
                note-surface := Rectangle {
                    visible: root.has-session && !root.item-missing && !root.load-failed;
                    x: root.width < 500px ? 8px : 12px;
                    y: 4px;
                    width: parent.width - (root.width < 500px ? 16px : 24px);
                    height: parent.height - 8px;
                    border-radius: Metrics.radius-lg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    background: Theme.canvas-default;
                    clip: true;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    header-bar := Rectangle {
                        height: 34px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;

                            // ── 左侧：标签区域（弹性宽度）──
                            tag-area := Rectangle {
                                horizontal-stretch: 1;
                                height: 100%;

                                // 整行可点：行内 chips 之间的空白与行尾也打开面板，
                                // 不依赖 chips 的实际宽度（字体度量不同地区/环境会变），
                                // chip 内的 × 与「+」仍由各自 TouchArea 先接收。
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-tag-panel(); }
                                }

                                Path {
                                    x: 2px;
                                    y: (parent.height - 14px) / 2;
                                    width: 14px;
                                    height: 14px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    stroke: Theme.fg-subtle;
                                    stroke-width: 1.1px;
                                    commands: "M 3 4 L 12 4 L 21 13 L 13 21 L 3 11 Z M 7 8 L 7.1 8";
                                }

                                tag-flick := Flickable {
                                    x: 22px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    interactive: false;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 6px;
                                            for tag-name[i] in root.tags: Rectangle {
                                                height: 22px;
                                                width: Math.min(tag-label.preferred-width + 30px, 150px);
                                                horizontal-stretch: 0;
                                                border-radius: Metrics.radius-md;
                                                background: Theme.accent-subtle;
                                                tag-label := Text {
                                                    x: 8px;
                                                    width: parent.width - 28px;
                                                    height: 100%;
                                                    text: tag-name;
                                                    color: Theme.accent-fg;
                                                    font-size: Metrics.text-xs;
                                                    font-weight: Metrics.weight-medium;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                Rectangle {
                                                    x: parent.width - 20px;
                                                    y: 2px;
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: Metrics.radius-sm;
                                                    background: remove-tag.has-hover ? Theme.hover-bg : transparent;
                                                    Text {
                                                        text: "×";
                                                        color: Theme.accent-fg;
                                                        font-size: Metrics.text-xs;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    remove-tag := TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        mouse-cursor: pointer;
                                                        clicked => { root.tag-remove(i); }
                                                    }
                                                }
                                            }
                                            if (root.tags.length == 0): Rectangle {
                                                height: 22px;
                                                width: add-empty-row.preferred-width + 16px;
                                                horizontal-stretch: 0;
                                                border-radius: Metrics.radius-md;
                                                border-width: 1px;
                                                border-color: empty-ta.has-hover ? Theme.border-default : Theme.border-subtle;
                                                background: empty-ta.has-hover ? Theme.hover-bg : transparent;
                                                animate background { duration: Motion.dur-color; easing: Motion.ease; }
                                                animate border-color { duration: Motion.dur-color; easing: Motion.ease; }
                                                add-empty-row := HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 4px;
                                                    alignment: center;
                                                    Text {
                                                        text: "+";
                                                        color: empty-ta.has-hover ? Theme.fg-default : Theme.fg-subtle;
                                                        font-size: Metrics.text-xs;
                                                        font-weight: Metrics.weight-medium;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: "添加标签";
                                                        color: empty-ta.has-hover ? Theme.fg-default : Theme.fg-subtle;
                                                        font-size: Metrics.text-xs;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                empty-ta := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.open-tag-panel(); }
                                                }
                                            }
                                            if (root.tags.length > 0): Rectangle {
                                                height: 22px;
                                                width: 22px;
                                                horizontal-stretch: 0;
                                                border-radius: Metrics.radius-md;
                                                border-width: 1px;
                                                border-color: add-ta.has-hover ? Theme.border-default : Theme.border-subtle;
                                                background: add-ta.has-hover ? Theme.hover-bg : transparent;
                                                animate background { duration: Motion.dur-color; easing: Motion.ease; }
                                                animate border-color { duration: Motion.dur-color; easing: Motion.ease; }
                                                Text {
                                                    text: "+";
                                                    color: add-ta.has-hover ? Theme.fg-default : Theme.fg-subtle;
                                                    font-size: Metrics.text-sm;
                                                    font-weight: Metrics.weight-medium;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                add-ta := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.open-tag-panel(); }
                                                    changed has-hover => {
                                                        if (self.has-hover) {
                                                            root.button-hint("添加标签 · 更改后自动保存", root.absolute-position.x + self.mouse-x, root.absolute-position.y + 26px);
                                                        } else {
                                                            root.button-hint-left();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ── 右侧：正文编辑工具组（文本模式）──
                            if (root.is-text): Rectangle {
                                width: 1px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                background: Theme.border-subtle;
                            }
                            if (root.is-text): HorizontalLayout {
                                horizontal-stretch: 0;
                                spacing: 2px;
                                alignment: end;
                                EditorTool {
                                    label: "撤销";
                                    icon: "M 9 5 L 4 10 L 9 15 M 4 10 L 14 10 C 21 10 21 20 14 20";
                                    tip: "撤销（Ctrl+Z）";
                                    clicked => { root.undo-seq += 1; }
                                    hint(text, x, y) => { root.button-hint(text, x, y); }
                                    hint-left => { root.button-hint-left(); }
                                }
                                EditorTool {
                                    label: "重做";
                                    icon: "M 15 5 L 20 10 L 15 15 M 20 10 L 10 10 C 3 10 3 20 10 20";
                                    tip: "重做（Ctrl+Y）";
                                    clicked => { root.redo-seq += 1; }
                                    hint(text, x, y) => { root.button-hint(text, x, y); }
                                    hint-left => { root.button-hint-left(); }
                                }
                                EditorTool {
                                    label: "全选";
                                    icon: "M 8 4 L 4 4 L 4 8 M 16 4 L 20 4 L 20 8 M 4 16 L 4 20 L 8 20 M 20 16 L 20 20 L 16 20 M 8 9 L 16 9 M 8 12 L 16 12 M 8 15 L 16 15";
                                    tip: "全选（Ctrl+A）";
                                    clicked => { root.select-all-seq += 1; }
                                    hint(text, x, y) => { root.button-hint(text, x, y); }
                                    hint-left => { root.button-hint-left(); }
                                }
                                Rectangle { width: 1px; height: 16px; y: (parent.height - self.height) / 2; background: Theme.border-subtle; }
                                EditorTool {
                                    label: "换行";
                                    tip: root.wrap-text ? "自动换行：开启" : "自动换行：关闭";
                                    active: root.wrap-text;
                                    clicked => { root.wrap-text = !root.wrap-text; root.wrap-toggle-seq += 1; }
                                    hint(text, x, y) => { root.button-hint(text, x, y); }
                                    hint-left => { root.button-hint-left(); }
                                }
                                EditorTool {
                                    label: "等宽";
                                    tip: root.monospace ? "等宽字体：开启" : "等宽字体：关闭";
                                    active: root.monospace;
                                    clicked => { root.monospace = !root.monospace; root.focus-body-seq += 1; }
                                    hint(text, x, y) => { root.button-hint(text, x, y); }
                                    hint-left => { root.button-hint-left(); }
                                }
                            }
                        }

                        // 顶部工作条统一底部分隔线
                        Rectangle {
                            y: parent.height - 1px;
                            width: 100%;
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                    }
                    // ── 正文占据顶部工作栏以外的全部高度 ──
                    Rectangle {
                        vertical-stretch: 1;

                        if (root.is-text): Rectangle {
                            width: 100%;
                            height: 100%;
                            property <int> focus-trigger: root.session-seq;
                            property <int> body-focus-trigger: root.focus-body-seq;
                            property <int> undo-trigger: root.undo-seq;
                            property <int> redo-trigger: root.redo-seq;
                            property <int> select-all-trigger: root.select-all-seq;
                            property <int> wrap-trigger: root.wrap-toggle-seq;
                            changed body-focus-trigger => { edit-input.focus(); }
                            changed undo-trigger => { edit-input.undo(); edit-input.focus(); }
                            changed redo-trigger => { edit-input.redo(); edit-input.focus(); }
                            changed select-all-trigger => { edit-input.focus(); edit-input.select-all(); }
                            changed wrap-trigger => { edit-scroll.scroll-x = 0px; edit-input.focus(); }
                            background: transparent;
                            clip: true;

                            init => {
                                edit-input.focus();
                                edit-input.set-selection-offsets(
                                    root.draft-byte-len, root.draft-byte-len);
                            }
                            changed focus-trigger => {
                                edit-scroll.scroll-y = 0px;
                                edit-input.focus();
                                edit-input.set-selection-offsets(
                                    root.draft-byte-len, root.draft-byte-len);
                            }

                        // 自管滚动
                        edit-scroll := Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px - (self.max-scroll-x > 0px ? 10px : 0px);
                            clip: true;
                            property <length> scroll-y: 0px;
                            property <length> scroll-x: 0px;
                            property <length> caret-x: 0px;
                            property <length> caret-y: 0px;
                            function reveal-cursor() {
                                let view-x = self.caret-x + 20px - self.scroll-x;
                                if (view-x < 8px || view-x > self.width - 16px) {
                                    self.scroll-x = Math.clamp(self.caret-x + 20px
                                        - (view-x < 8px ? 8px : self.width - 16px), 0px, self.max-scroll-x);
                                }
                                let view-y = self.caret-y + 16px - self.scroll-y;
                                if (view-y < 8px || view-y + 23px > self.height - 8px) {
                                    self.scroll-y = Math.clamp(self.caret-y + 16px
                                        - (view-y < 8px ? 8px : self.height - 31px), 0px, self.max-scroll-y);
                                }
                            }
                            changed height => { self.reveal-cursor(); }
                            changed width => { self.reveal-cursor(); }
                            property <length> content-width: root.wrap-text ? self.width
                                : Math.max(self.width, edit-input.preferred-width + 40px);
                            property <length> max-scroll-x: Math.max(0px, self.content-width - self.width);
                            changed max-scroll-y => { self.scroll-y = Math.min(self.scroll-y, self.max-scroll-y); }
                            changed max-scroll-x => { self.scroll-x = Math.min(self.scroll-x, self.max-scroll-x); }
                            // 内容高 = 全文排版高 + 上下 padding 32
                            property <length> max-scroll-y:
                                Math.max(0px, edit-input.preferred-height + 32px - self.height);

                            inner := Rectangle {
                                x: -edit-scroll.scroll-x;
                                y: -edit-scroll.scroll-y;
                                width: edit-scroll.content-width;
                                height: Math.max(edit-input.preferred-height + 32px,
                                    edit-scroll.height);

                                // 输入宿主：必须是 TextInput 的祖先——滚轮在
                                // TextInput 忽略后沿父链冒泡才到这里（兄弟收
                                // 不到）；空白区点击聚焦并光标置尾（旧版
                                // textarea 整块可点语义）
                                edit-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: text;
                                    scroll-event(event) => {
                                        // Windows 滚轮向下 delta_y 为负：向下滚
                                        // = 看下方内容 = scroll-y 增大，故取负
                                        edit-scroll.scroll-y = Math.clamp(
                                            edit-scroll.scroll-y - event.delta_y,
                                            0px,
                                            edit-scroll.max-scroll-y);
                                        edit-scroll.scroll-x = Math.clamp(
                                            edit-scroll.scroll-x - event.delta-x, 0px, edit-scroll.max-scroll-x);
                                        return accept;
                                    }
                                    clicked => {
                                        edit-input.focus();
                                        edit-input.set-selection-offsets(
                                            root.draft-byte-len, root.draft-byte-len);
                                    }

                                    // 占位符自绘（原生 TextInput 无 placeholder 属性）
                                    if (edit-input.text == "" && !edit-input.has-focus): Text {
                                        x: 20px;
                                        y: 16px;
                                        width: parent.width - 40px;
                                        height: 23px;
                                        text: "在此输入或修改文本…";
                                        color: Theme.fg-subtle;
                                        font-size: Metrics.text-sm;
                                        vertical-alignment: top;
                                    }
                                    // 顶边对齐的裁剪容器：软件渲染器在非整数 DPI
                                    // 缩放（125% 实测）下会把光标条顶端画出 TextInput
                                    // 元素几何 1-2px（parley 行盒顶高于元素顶），增量
                                    // 重绘的脏区只认元素几何——越界段「画得上、擦不
                                    // 掉」，在首行文字上方残留孤立白点（离屏复现实验
                                    // 证实，见 docs/editor-window.md；旧修复是同色遮罩条盖
                                    // 住，与透明底不兼容已退役）。裁剪层顶与 TextInput
                                    // 顶重合，越界段在绘制管线直接被裁，不依赖底色
                                    Rectangle {
                                        x: 20px;
                                        y: 16px;
                                        width: parent.width - 40px;
                                        height: parent.height - 32px;
                                        clip: true;

                                        edit-input := TextInput {
                                            x: 0;
                                            y: 0;
                                            width: 100%;
                                            height: 100%;
                                            single-line: false;
                                            wrap: root.wrap-text ? word-wrap : no-wrap;
                                            font-family: root.monospace ? Metrics.font-code : root.default-font-family;
                                            font-size: Metrics.text-preview;
                                            line-height-factor: 1.4;
                                            page-height: edit-scroll.height;
                                            color: Theme.fg-default;
                                            selection-foreground-color: Theme.selection-fg;
                                            selection-background-color: Theme.selection-bg;
                                            text <=> root.draft-text;
                                            edited() => { root.text-edited(self.text); }
                                            cursor-position-changed(cursor) => {
                                                // 行列上报（byte offset 由 TextInput 内部
                                                // 属性读出，Rust 按 draft 文本换算）
                                                root.editor-cursor-moved(
                                                    edit-input.cursor-position_byte-offset);
                                                edit-scroll.caret-x = cursor.x;
                                                edit-scroll.caret-y = cursor.y;
                                                edit-scroll.reveal-cursor();
                                            }
                                        }
                                    }

                                }
                                }

                                // 滚动条：内容超出视口时显示。滑块高度按视口/
                                // 内容比例（最小 24px），轨道点击跳转、拖拽跟随
                                if (edit-scroll.max-scroll-y > 0px): scrollbar := Rectangle {
                                    x: parent.width - self.width;
                                    y: 0;
                                    width: 8px;
                                    height: parent.height;
                                    // 滑块几何（thumb-h 用视口²/内容² 的经典比例）
                                    property <length> thumb-h: Math.max(24px,
                                        self.height * self.height / Math.max(content-h, 1px));
                                    property <length> content-h: edit-input.preferred-height + 32px;
                                    property <length> thumb-y: (edit-scroll.scroll-y
                                        / Math.max(edit-scroll.max-scroll-y, 1px))
                                        * Math.max(self.height - thumb-h, 1px);

                                    track-ta := TouchArea {
                                        property <length> grab-offset;
                                        width: 100%;
                                        height: 100%;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down) {
                                                self.grab-offset = self.pressed-y >= scrollbar.thumb-y && self.pressed-y <= scrollbar.thumb-y + scrollbar.thumb-h
                                                    ? self.pressed-y - scrollbar.thumb-y : scrollbar.thumb-h / 2;
                                                edit-scroll.scroll-y = Math.clamp(
                                                    (self.mouse-y - self.grab-offset)
                                                        / Math.max(scrollbar.height - scrollbar.thumb-h, 1px)
                                                        * edit-scroll.max-scroll-y,
                                                    0px, edit-scroll.max-scroll-y);
                                            }
                                        }
                                        moved => {
                                            if (self.pressed) {
                                                edit-scroll.scroll-y = Math.clamp(
                                                    (self.mouse-y - self.grab-offset)
                                                        / Math.max(scrollbar.height - scrollbar.thumb-h, 1px)
                                                        * edit-scroll.max-scroll-y,
                                                    0px, edit-scroll.max-scroll-y);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: 2px;
                                        y: scrollbar.thumb-y;
                                        width: parent.width - 4px;
                                        height: scrollbar.thumb-h;
                                        border-radius: 2px;
                                        background: track-ta.pressed || track-ta.has-hover
                                            ? Theme.border-default : Theme.border-subtle;
                                        animate background { duration: Motion.dur-color; easing: Motion.ease; }
                                    }
                                }
                            }
                            if (edit-scroll.max-scroll-x > 0px): Rectangle {
                                x: 8px;
                                y: parent.height - 10px;
                                width: parent.width - 16px;
                                height: 8px;
                                property <length> thumb-width: Math.max(24px, self.width * edit-scroll.width / edit-scroll.content-width);
                                property <length> thumb-x: edit-scroll.scroll-x / Math.max(1px, edit-scroll.max-scroll-x) * (self.width - self.thumb-width);
                                horizontal-track := TouchArea {
                                    property <length> grab-offset;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            self.grab-offset = self.pressed-x >= parent.thumb-x && self.pressed-x <= parent.thumb-x + parent.thumb-width
                                                ? self.pressed-x - parent.thumb-x : parent.thumb-width / 2;
                                            edit-scroll.scroll-x = Math.clamp((self.mouse-x - self.grab-offset)
                                                / Math.max(1px, parent.width - parent.thumb-width) * edit-scroll.max-scroll-x,
                                                0px, edit-scroll.max-scroll-x);
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            edit-scroll.scroll-x = Math.clamp((self.mouse-x - self.grab-offset)
                                                / Math.max(1px, parent.width - parent.thumb-width) * edit-scroll.max-scroll-x,
                                                0px, edit-scroll.max-scroll-x);
                                        }
                                    }
                                }
                                Rectangle {
                                    x: parent.thumb-x;
                                    y: 2px;
                                    width: parent.thumb-width;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: horizontal-track.has-hover || horizontal-track.pressed ? Theme.border-default : Theme.border-subtle;
                                }
                            }
                    }

                        if (!root.is-text): Rectangle {
                            width: 100%;
                            height: 100%;
                            background: transparent;
                            clip: true;

                        if (root.has-image): Rectangle {
                            // 旧版 img：rounded-md + 1px border-subtle 描边
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: parent.height - 32px;
                            border-radius: Metrics.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            background: Theme.is-dark ? #18191c : #f5f6f8;
                            clip: true;
                            Image {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                source: root.image-preview;
                                image-fit: contain;
                            }
                            // 右下角「打开」：预览是 contain 缩略，细看交系统查看器
                            open-img-btn := Rectangle {
                                x: parent.width - self.width - 12px;
                                y: parent.height - self.height - 12px;
                                width: open-img-row.preferred-width + 24px;
                                height: 28px;
                                border-radius: Metrics.radius-pill;
                                border-width: 1px;
                                border-color: Theme.border-default;
                                opacity: open-img-ta.pressed ? 0.85 : 1.0;
                                background: Theme.canvas-default;
                                Rectangle {
                                    border-radius: Metrics.radius-pill;
                                    background: open-img-ta.has-hover ? Theme.hover-bg : transparent;
                                    animate background { duration: Motion.dur-color; easing: Motion.ease; }
                                }
                                open-img-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-externally(root.image-path); }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.button-hint("用系统查看器打开",
                                                open-img-btn.absolute-position.x,
                                                open-img-btn.absolute-position.y + open-img-btn.height + 4px);
                                        } else {
                                            root.button-hint-left();
                                        }
                                    }
                                }
                                open-img-row := HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "打开";
                                        color: Theme.fg-default;
                                        font-size: Metrics.text-xs;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        if (root.image-loading): Text {
                            y: (parent.height - self.height) / 2;
                            x: (parent.width - self.width) / 2;
                            text: "正在加载图片…";
                            color: Theme.fg-subtle;
                            font-size: Metrics.text-sm;
                        }
                        if (root.image-failed): Text {
                            y: (parent.height - self.height) / 2;
                            x: (parent.width - self.width) / 2;
                            text: "图片预览不可用";
                            color: Theme.fg-subtle;
                            font-size: Metrics.text-sm;
                        }
                        // 文件条目：路径列表
                        if (!root.has-image && !root.image-loading && !root.image-failed
                            && root.file-paths.length > 0): Flickable {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: parent.height - 32px;
                            content-width: self.width;
                            // false=点击透传（行可点打开），滚轮仍可滚
                            interactive: false;
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                for path[i] in root.file-paths: Rectangle {
                                    height: max(32px, path-label.height + 12px);
                                    border-radius: Metrics.radius-md;
                                    border-width: 1px;
                                    // hover 描边 + 文字提亮提示可点（行底色与
                                    // 预览区同底，色块反馈无区分度）
                                    border-color: path-ta.has-hover ? Theme.border-subtle : transparent;
                                    animate border-color { duration: Motion.dur-color; easing: Motion.ease; }
                                    background: Theme.canvas-default;
                                    path-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-file-path-at(i); }
                                    }
                                    Path {
                                        x: 12px;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        stroke: path-ta.has-hover ? Theme.accent-fg : Theme.fg-subtle;
                                        stroke-width: 1.2px;
                                        commands: "M 14 2 L 6 2 C 4.9 2 4 2.9 4 4 L 4 20 C 4 21.1 4.9 22 6 22 L 18 22 C 19.1 22 20 21.1 20 20 L 20 8 Z M 14 2 L 14 8 L 20 8";
                                    }
                                    path-label := Text {
                                        x: 34px;
                                        y: (parent.height - self.height) / 2;
                                        width: max(0px, parent.width - self.x - 12px);
                                        text: path;
                                        color: path-ta.has-hover ? Theme.fg-default : Theme.fg-muted;
                                        font-size: Metrics.text-body;
                                        vertical-alignment: center;
                                        wrap: char-wrap;
                                    }
                                }
                            }
                        }
                        if (!root.has-image && !root.image-loading && !root.image-failed
                            && root.file-paths.length == 0): Text {
                            y: (parent.height - self.height) / 2;
                            x: (parent.width - self.width) / 2;
                            text: "此条目内容不支持预览";
                            color: Theme.fg-subtle;
                            font-size: Metrics.text-sm;
                        }
                        }
                    }

                }
                }
            }

            // 状态栏承载来源、编辑状态和低频删除入口。
            Rectangle {
                height: 28px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    Text {
                        text: root.has-session ? "\{root.meta-source} · \{root.meta-time}" : "";
                        color: Theme.fg-subtle;
                        font-size: Metrics.text-xs;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if (root.is-text && root.has-session): Text {
                        text: "行 \{root.cursor-line}，列 \{root.cursor-col} · \{root.char-count} 字";
                        color: Theme.fg-subtle;
                        font-size: Metrics.text-xs;
                        vertical-alignment: center;
                    }
                    if (!root.is-text && root.has-session): Text {
                        text: root.meta-extra;
                        color: Theme.fg-subtle;
                        font-size: Metrics.text-xs;
                        vertical-alignment: center;
                    }
                    if (root.is-text && root.has-session && !root.item-missing && !root.load-failed): SaveButton {
                        is-dirty: root.is-dirty;
                        clicked => { root.save-requested(); }
                        hint(x, y) => { root.button-hint(root.is-dirty ? "保存（Ctrl+S）" : "内容已保存", x, y); }
                        hint-left => { root.button-hint-left(); }
                    }
                    if (root.has-session && !root.item-missing && !root.load-failed): DeleteButton {
                        armed: root.delete-armed;
                        clicked => { root.delete-requested(); }
                        hint(x, y) => { root.button-hint(root.delete-armed ? "再次点击确认删除" : "删除条目", x, y); }
                        hint-left => { root.button-hint-left(); }
                    }
                }
            }
        }

        // ── 标签面板：root-scope 直挂 + 声明在 VerticalLayout 之后。
        // Slint 按声明顺序绘制且无 z-index，这里的浮层会被后声明的
        // 内容区盖住。Notion/GitHub 多选模式：搜索框 + 已选区（点击
        // 移除）+ 建议区（点击/回车添加）。常驻实例而非 if 条件实例化：
        // 条件实例化无法做退场动画；opacity 淡入淡出 + 4px 位移进场，
        // TouchArea 由 tag-open 门控，隐藏与淡出中不拦截指针。
        // 定位读标签条的窗口绝对坐标，自动跟随通知/错误条高度变化
        Rectangle {
            // 容器比面板卡大四周 10px（弹层柔影的落影面——drop-shadow
            // 在软件渲染下是空实现，见 theme.slint SoftShadow 注释）；
            // 定位锚点反补同值，面板卡视觉位置不变
            x: header-bar.absolute-position.x - 10px;
            y: header-bar.absolute-position.y + header-bar.height + 4px - 10px;
            width: 340px;
            // 内部真实内容所需高度：
            // 搜索框 44px + 分隔线 1px = 45px
            // 已选区：表头 20px + 条目 tags.length * 32px
            // 分隔线：9px（当两者共存）
            // 建议区：表头 20px + 条目 suggestions.length * 32px
            // 列表上下内边距：8px
            property <length> panel-content-h:
                45px
                + (root.tags.length > 0 ? (20px + root.tags.length * 32px) : 0px)
                + (root.tags.length > 0 && root.tag-suggestions.length > 0 ? 9px : 0px)
                + (root.tag-suggestions.length > 0 ? (20px + root.tag-suggestions.length * 32px) : 0px)
                + 8px;
            property <length> max-panel-h: Math.min(420px, Math.max(54px, root.height - 40px - header-bar.absolute-position.y - header-bar.height - 4px));

            height: Math.min(max-panel-h, panel-content-h) + 20px;
            opacity: root.tag-open ? 1.0 : 0.0;
            animate opacity { duration: Motion.dur-enter; easing: Motion.ease; }
            clip: true;

            // 柔影垫底（几何同 panel-body）
            SoftShadow {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                layers: 8;
                step: 1px;
                offset-y: 0px;
                radius: Metrics.radius-md;
                alpha: 0.08;
            }
            panel-body := Rectangle {
                x: 10px;
                y: 10px + (root.tag-open ? 0px : 4px);
                animate y { duration: Motion.dur-enter; easing: Motion.ease; }
                width: parent.width - 20px;
                height: parent.height - 20px;
                border-radius: Metrics.radius-md;
                border-width: 1px;
                border-color: Theme.is-dark ? #FFFFFF.with-alpha(0.08) : Theme.border-subtle;
                background: Theme.canvas-default;
                clip: true;

                VerticalLayout {
                    // 搜索框（内部绝对定位：Rectangle 子元素不自动铺满，
                    // 且显式几何断开 TextInput 首选宽的布局传导）
                    Rectangle {
                        height: 44px;
                        panel-input-wrap := Rectangle {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            height: 28px;
                            border-radius: Metrics.radius-md;
                            border-width: 1px;
                            border-color: panel-input.has-focus ? Theme.border-accent : Theme.border-subtle;
                            background: Theme.canvas-subtle;
                            Path {
                                x: 8px;
                                y: 8px;
                                width: 12px;
                                height: 12px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: Theme.fg-subtle;
                                stroke-width: 1.8px;
                                commands: "M 11 19 A 8 8 0 1 0 11 3 A 8 8 0 0 0 11 19 Z M 21 21 L 16.65 16.65";
                            }
                            Rectangle {
                                x: 25px;
                                width: parent.width - 33px;
                                height: parent.height;
                                if (panel-input.text == ""): Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "搜索或创建标签";
                                    color: Theme.fg-subtle;
                                    font-size: Metrics.text-body;
                                    vertical-alignment: center;
                                }
                                    panel-input := TextInput {
                                        // 隐藏态必须禁用：opacity 0 的元素仍参
                                        // 与鼠标命中，不门控会抢走编辑区上部的
                                        // 点击（「鼠标失灵」根因之一）
                                        enabled: root.tag-open;
                                        width: parent.width;
                                    // TextInput 墨迹从元素顶部画：按字号收
                                    // 高度再垂直居中（见编辑区同款注释）
                                    y: (parent.height - self.font-size) / 2;
                                    height: self.font-size;
                                    font-size: Metrics.text-body;
                                    color: Theme.fg-default;
                                    selection-foreground-color: Theme.selection-fg;
                                    selection-background-color: Theme.selection-bg;
                                    text <=> root.tag-input-text;
                                    edited() => { root.tag-input-changed(self.text); }
                                    // 点击面板外（焦点离开搜索框）即收起面板
                                    changed has-focus => {
                                        if (!self.has-focus && root.tag-open) {
                                            root.tag-open = false;
                                        }
                                    }
                                        key-pressed(event) => {
                                            if ((event.text == Key.DownArrow
                                                    || event.text == Key.UpArrow)
                                                && root.tag-suggestions.length > 0)
                                            {
                                                root.tag-highlight = Math.mod(
                                                    root.tag-active
                                                        + (event.text == Key.DownArrow ? 1 : -1),
                                                    root.tag-suggestions.length,
                                                );
                                                // 高亮行保持可见：建议行视口系顶 =
                                                // 已选区高（含表头与分隔线）+ 建议表头 + 建议行索引 × 行高 + padding
                                                let row-top = (root.tags.length > 0 ? (20px + root.tags.length * 32px + 9px) : 0px)
                                                    + 20px + root.tag-active * 32px + 4px;
                                                if (row-top < -panel-flick.content-y) {
                                                    panel-flick.content-y = -row-top;
                                                } else if (row-top + 32px
                                                    > -panel-flick.content-y + panel-flick.height)
                                                {
                                                    panel-flick.content-y =
                                                        -(row-top + 32px - panel-flick.height);
                                                }
                                                return accept;
                                            }
                                            if (event.text == Key.Return) {
                                                root.tag-commit-add();
                                                return accept;
                                            }
                                            if (event.text == Key.Tab) {
                                                root.tag-complete();
                                                return accept;
                                            }
                                            if (event.text == Key.Backspace
                                                && root.tag-input-text == ""
                                                && root.tags.length > 0)
                                            {
                                                root.tag-remove-last();
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                            }
                    }
                    // 分隔线
                    Rectangle { height: 1px; background: Theme.border-subtle; }
                    // 行列表（已选区 + 建议区）
                    panel-flick := Flickable {
                        width: 100%;
                        vertical-stretch: 1;
                        // false=行点击透传（列表超出面板封顶高时不吞点击），
                        // 滚轮仍可滚；键盘导航的滚动跟随是显式写 content-y
                        interactive: false;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 0px;

                            // 已选区：点击行 = 移除该标签（勾号标记归属）
                            if (root.tags.length > 0): Rectangle {
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "已选标签";
                                        color: Theme.fg-subtle;
                                        font-size: 11px;
                                        font-weight: Metrics.weight-medium;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            for tag-name[i] in root.tags: Rectangle {
                                height: 32px;
                                border-radius: Metrics.radius-md;
                                background: sel-ta.has-hover ? Theme.hover-bg : transparent;
                                sel-ta := TouchArea {
                                    // 隐藏态必须禁用：与 panel-input/sug-ta 同理，
                                    // opacity 0 的已选行仍参与鼠标命中，会吃掉
                                    // 编辑区上部的点击
                                    enabled: root.tag-open;
                                    mouse-cursor: pointer;
                                    // pointer-down 即移除（与建议行同语义）
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            root.tag-remove(i);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 14px;
                                            height: 14px;
                                            viewbox-width: 24;
                                            viewbox-height: 24;
                                            stroke: Theme.accent-fg;
                                            // Slint 描边不随视框缩放：1.8 @24 → 14px 折算 1.05px
                                            stroke-width: 1.05px;
                                            commands: "M 4 12.5 L 9.5 18 L 20 6.5";
                                        }
                                    }
                                    Text {
                                        text: tag-name;
                                        color: Theme.fg-default;
                                        font-size: Metrics.text-body;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    if (sel-ta.has-hover): Rectangle {
                                        height: 20px;
                                        border-radius: Metrics.radius-sm;
                                        background: Theme.danger-subtle;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: "移除";
                                                color: Theme.danger-fg;
                                                font-size: Metrics.text-xs;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // 已选与建议之间的微型分隔线
                            if (root.tags.length > 0 && root.tag-suggestions.length > 0): Rectangle {
                                height: 9px;
                                Rectangle {
                                    y: 4px;
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.border-subtle;
                                }
                            }

                            // 建议区：kind 0=match 1=create 2=exists
                            if (root.tag-suggestions.length > 0): Rectangle {
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.tag-input-text != "" ? "搜索结果" : "推荐标签";
                                        color: Theme.fg-subtle;
                                        font-size: 11px;
                                        font-weight: Metrics.weight-medium;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            for sug[i] in root.tag-suggestions: Rectangle {
                                height: 32px;
                                border-radius: Metrics.radius-md;
                                background: i == root.tag-active
                                    ? Theme.canvas-subtle : transparent;
                                sug-ta := TouchArea {
                                    enabled: root.tag-open;
                                    mouse-cursor: default;
                                    // pointer-down 即采纳：采纳引发失焦收面板
                                    // 抢在 pointer-up 前发生也不丢点击
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            root.tag-adopt(i);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    if (sug.kind == 0): HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: sug.name;
                                            color: Theme.fg-default;
                                            font-size: Metrics.text-body;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: sug.count-text;
                                            color: Theme.fg-subtle;
                                            font-size: Metrics.text-hint;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if (sug.kind == 1): Text {
                                        text: "创建标签「" + sug.name + "」";
                                        color: Theme.accent-fg;
                                        font-size: Metrics.text-body;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if (sug.kind == 2): Text {
                                        text: "「" + sug.name + "」已添加";
                                        color: Theme.fg-subtle;
                                        font-size: Metrics.text-body;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                // 超出最大高度时的微型滚动条指示器
                if (panel-content-h - 45px > panel-flick.height): Rectangle {
                    x: parent.width - 6px;
                    y: 49px;
                    width: 3px;
                    height: panel-flick.height - 8px;
                    Rectangle {
                        width: 100%;
                        height: Math.max(16px, parent.height * parent.height / Math.max(1px, (panel-content-h - 45px)));
                        y: (-panel-flick.content-y / Math.max(1px, (panel-content-h - 45px) - panel-flick.height))
                            * Math.max(0px, parent.height - self.height);
                        border-radius: 1.5px;
                        background: Theme.fg-subtle;
                        opacity: 0.4;
                    }
                }
            }
        }

        // ── 未保存关闭确认（旧版 role=dialog，max-w-sm p-6）──
        // visible 而非 if：dlg-save 需在会话打开时被 focus（对齐旧版
        // closeConfirmOpen effect 聚焦主按钮）；opacity 进场淡入
        // （root-scope 非布局容器，visible 不占位问题在此不存在）
        Rectangle {
            visible: root.close-confirm-open;
            opacity: root.close-confirm-open ? 1.0 : 0.0;
            animate opacity { duration: Motion.dur-color; easing: Motion.ease; }
            background: rgba(0, 0, 0, 0.45);
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // 阴影宿：透明包裹层撑起柔影范围（drop-shadow 在
                        // 软件渲染下是空实现，见 SoftShadow 注释），真卡在内
                        width: 384px;
                        height: dlg-card.height;
                        SoftShadow {
                            width: 100%;
                            height: 100%;
                            layers: 10;
                            step: 1.2px;
                            offset-y: 2px;
                            radius: Metrics.radius-lg + 4px;
                            alpha: 0.25;
                        }
                        dlg-card := Rectangle {
                        width: 100%;
                        height: dlg-col.preferred-height;
                        border-radius: Metrics.radius-lg + 4px;
                        background: Theme.canvas-default;
                        dlg-col := VerticalLayout {
                            padding: 24px;
                            spacing: 8px;
                            Text {
                                text: "有未保存的文本修改";
                                color: Theme.fg-default;
                                font-size: 18px;
                                font-weight: Metrics.weight-semibold;
                            }
                            Text {
                                text: "关闭前是否保存文本？标签更改已自动保存。";
                                color: Theme.fg-muted;
                                font-size: Metrics.text-sm;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                dlg-cancel := Rectangle {
                                    width: 80px;
                                    height: 36px;
                                    border-radius: Metrics.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-default;
                                    opacity: dlg-cancel-ta.pressed ? 0.85 : 1.0;
                                    background: dlg-cancel-ta.has-hover ? Theme.hover-bg : transparent;
                                    animate background { duration: Motion.dur-color; easing: Motion.ease; }
                                    dlg-cancel-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => { root.confirm-cancel(); }
                                    }
                                    Text {
                                        text: "继续编辑";
                                        color: Theme.fg-default;
                                        font-size: Metrics.text-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                dlg-discard := Rectangle {
                                    width: 112px;
                                    height: 36px;
                                    border-radius: Metrics.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-default;
                                    opacity: dlg-discard-ta.pressed ? 0.85 : 1.0;
                                    background: dlg-discard-ta.has-hover ? Theme.hover-bg : transparent;
                                    animate background { duration: Motion.dur-color; easing: Motion.ease; }
                                    dlg-discard-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => { root.close-discard(); }
                                    }
                                    Text {
                                        text: "放弃文本修改";
                                        color: Theme.danger-fg;
                                        font-size: Metrics.text-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                dlg-save := Rectangle {
                                    width: 100px;
                                    height: 36px;
                                    border-radius: Metrics.radius-md;
                                    opacity: dlg-save-ta.pressed ? 0.85 : 1.0;
                                    background: dlg-save-ta.has-hover
                                        ? Theme.accent-hover : Theme.accent-emphasis;
                                    animate background { duration: Motion.dur-color; easing: Motion.ease; }
                                    dlg-save-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => { root.close-save(); }
                                    }
                                    Text {
                                        text: "保存并关闭";
                                        color: Theme.fg-on-emphasis;
                                        font-size: Metrics.text-sm;
                                        font-weight: Metrics.weight-semibold;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        }
                    }
                }
            }
        // 确认框的键盘（Esc=取消 / Enter=保存并关闭）由窗口级 capture
        // 统一处理，不依赖按钮焦点
        }
    }
    } // panel

}
