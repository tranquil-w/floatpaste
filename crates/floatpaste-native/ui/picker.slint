// 速贴面板：对齐原版 PickerShell.tsx 的完整复刻。
// - 无边框透明窗 + 8px 圆角卡片 + 1px 窗口边框（DWM 阴影与系统圆角
//   由 Rust 侧处理，见 win32_ext::apply_dwm_*）
// - 顶栏：软件图标 + 居中拖拽横条 + 关闭按钮，
//   整条背景可拖拽移动窗口；操作失败提示走托盘系统通知，不占面板 UI
// - 列表：多行预览（最多 4 行）、72px 缩略图、数字徽章、类型徽章、来源、
//   相对时间、收藏星标、标签行（常显，行高不随选中变化）
// - 交互：单击选中 / 双击上屏 / 悬停 400ms 预览（Rust 调度）
// - 键盘全程不经窗口焦点（LL 键盘钩子会话），窗口本身不抢焦点
import { Theme, Metrics, Motion } from "theme.slint";

export struct ClipRow {
    id: string,
    preview: string,
    type-label: string,
    source-app: string,
    time-text: string,
    favorited: bool,
    digit: string,
    has-thumb: bool,
    thumb: image,
    tags: [string],
    tag-more: int,
}

// ── 面板结构几何：slint 布局与 Rust 首帧兜底共用的常量，禁双边手抄 ──
// Rust 读取经 global::<PanelGeometry>()；改这里即同时改变布局与裁排
export global PanelGeometry {
    out property <length> card-border: 1px;                // 窗口卡片 1px 边框（两侧共 2px）
    out property <length> scroll-slot: 10px;               // 列表右侧滚动槽
    out property <length> list-pad-left: 14px;             // 原版 grid pl-[14px]
    out property <length> list-pad-right: Metrics.space-1; // 原版 grid pr-1
    out property <length> row-inset: 2px;                 // 行卡片内容边距（单侧）；选中描边向内画在卡片边缘内侧
    out property <length> row-frame: 2 * row-inset;       // 行卡片内容边距双层（Rust 裁排经 preview-pad-h 扣除）
    out property <length> row-pad-left: 12px;              // 行内左 padding
    out property <length> row-pad-right: Metrics.space-1_5; // 行内右 padding（单侧）
    out property <length> thumb-size: 72px;
    out property <length> thumb-gap: 10px;
    // 窗口卡片圆角（Rust 侧模糊底图按此烘焙圆角 alpha，见 core::backdrop）
    out property <length> card-radius: Metrics.radius-lg;
    // 预览可用宽需从 flick 宽扣除的横向总量（Rust 首帧兜底同式）
    out property <length> preview-pad-h:
        list-pad-left + list-pad-right + row-frame + row-pad-left + row-pad-right;
}

// ── 拉伸手柄：八方向共用，direction 编码对齐 resize-started 回调 ──
// 东西向手柄悬停显 accent-subtle 底（旧版 west/east 的 hover:bg-pg-accent-subtle）
component ResizeHandle inherits Rectangle {
    in property <int> direction; // 0=N 1=S 2=W 3=E 4=NW 5=NE 6=SW 7=SE
    background: handle-ta.has-hover && (direction == 2 || direction == 3)
        ? Theme.accent-subtle : transparent;
    callback started();
    callback drag-moved();
    callback finished();

    handle-ta := TouchArea {
        mouse-cursor: direction == 0 || direction == 4 || direction == 5 ? n-resize
            : direction == 1 || direction == 6 || direction == 7 ? s-resize
            : direction == 2 ? w-resize
            : e-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.started();
            }
            if (e.kind == PointerEventKind.up) {
                root.finished();
            }
        }
        moved => { root.drag-moved(); }
    }
}

// ── 列表滚动条：10px 稳定槽 + 4px 视觉拇指（对齐原版 webkit 拇指全槽可抓）──
// 搜索窗口复用同一组件
export component ListScrollBar inherits Rectangle {
    in property <length> content-height;
    in property <length> visible-height;
    in-out property <length> content-y;
    // 用户以滚动条驱动滚动的信号（点击轨道/拖拽拇指）；设置窗用于
    // 解除导航点击的 scroll-spy 锁定。不连接则无行为（速贴/搜索窗）
    callback user-scrolled();

    track-ta := TouchArea {
        clicked => {
            // 点击轨道：滚到对应位置。只驱动 content-y，
            // thumb.y 始终由声明式绑定跟随滚动
            if (self.mouse-y < thumb.y || self.mouse-y > thumb.y + thumb.height) {
                if (thumb.max-y > 0) {
                    root.content-y = -(Math.min(thumb.max-y, Math.max(0, self.mouse-y - thumb.height / 2)) / thumb.max-y)
                        * (root.content-height - root.visible-height);
                    root.user-scrolled();
                }
            }
        }
    }

    thumb := Rectangle {
        property <length> max-y: parent.height - self.height;
        y: root.content-height > root.visible-height && self.max-y > 0
            ? Math.min(self.max-y, Math.max(0, (-root.content-y) / (root.content-height - root.visible-height) * self.max-y))
            : 0;
        height: Math.max(30px, root.visible-height * root.visible-height / root.content-height);
        width: 4px;
        x: 3px;
        border-radius: 2px;
        background: thumb-ta.has-hover ? Theme.border-default : Theme.border-muted;

        // 拖拽热区扩到整条 10px 槽（原版 webkit 拇指含透明边，
        // 可抓取宽度就是全槽宽）
        thumb-ta := TouchArea {
            x: -3px;
            width: 10px;
            // 拖拽锚点记窗口坐标：TouchArea 随拇指一起动，本地
            // mouse-y 会被自身移动抵消（拇指只走约一半路程）。
            // absolute-position 与 mouse-y 随元素移动反向互补，
            // 两者之和在整个拖拽过程是稳定的窗口坐标
            property <length> press-thumb-y;
            property <length> press-mouse-y;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.press-thumb-y = thumb.y;
                    self.press-mouse-y = self.absolute-position.y + self.mouse-y;
                }
            }
            moved => {
                if (self.pressed && thumb.max-y > 0) {
                    // 只写 content-y：直接赋值 thumb.y 会顶掉它的
                    // 绑定，拖拽一次后滚轮/惯性滚动不再更新拇指
                    let target = Math.min(thumb.max-y, Math.max(0,
                        self.press-thumb-y
                            + (self.absolute-position.y + self.mouse-y - self.press-mouse-y)));
                    root.content-y = -(target / thumb.max-y)
                        * (root.content-height - root.visible-height);
                    root.user-scrolled();
                }
            }
        }
    }
}

// ── 行卡片：预览排版、元信息与选中态的完整行内 UI ──
// 行高稳定性不变量收口在本组件：标尺与预览文本同文本、同宽度、
// 同字重（Metrics.weight-semibold，与 Rust 裁排的 measure-preview 一致）；
// 选中只切观感字重（500↔600），行高在两态间保持不变
component ClipRowCard inherits Rectangle {
    in property <ClipRow> data;
    in property <bool> selected;
    in property <length> text-width;
    // 面板处于自绘模糊底图形态时行卡半透（玻璃卡透底）；实底形态保持
    // 不透明——底下是平色层灰，透它没有意义
    in property <bool> blur-active: false;
    callback clicked();
    callback double-clicked();
    callback hover(length, length);
    callback hover-left();
    callback scroll-into-view(length, length);

    property <bool> is-selected: selected;
    changed is-selected => {
        if (self.is-selected) {
            self.scroll-into-view(self.y, self.height);
        }
    }

    // 选中态强调 = 2px 墨色描边（fg-default @0.70，浅色=深墨/深色=
    // 白墨，与文字同源、随明暗反色；加粗配减淡平衡存在感）+ 选中
    // 字重（semibold），无底色变化。描边由组件末尾的顶层环向内
    // 重画——画在卡片（card-face）边缘内侧，卡片外轮廓不随选中
    // 变化；宽度只在那一处声明，改宽不动 padding 与
    // PanelGeometry.row-frame
    border-radius: Metrics.radius-lg;

    // 浮起下投影（自绘）：软件渲染的 draw_box_shadow 是空实现（slint
    // 1.18.1 内 // TODO，通用柔影见 theme.slint SoftShadow）。行卡是
    // 半透玻璃卡，SoftShadow 的实心层不能垫在卡下（透射会把卡面压暗
    // 一档），改用「卡底以下 2px 裁剪窗 + 两个整卡形状向下错位 1px/
    // 2px 的圆角垫底」：与卡重叠的上侧被窗裁掉（半透卡零透射），
    // 露出的暗带端点随卡片圆角自然内收——直角底带会在圆角处冒线头
    Rectangle {
        x: PanelGeometry.row-inset;
        y: root.height - PanelGeometry.row-inset;
        width: root.width - 2 * PanelGeometry.row-inset;
        height: 2px;
        clip: true;
        Rectangle {
            x: 0;
            y: 2 * PanelGeometry.row-inset + 1px - root.height;
            width: parent.width;
            height: root.height - 2 * PanelGeometry.row-inset;
            border-radius: Metrics.radius-lg;
            background: Theme.shadow-color.with-alpha(0.14);
        }
        Rectangle {
            x: 0;
            y: 2 * PanelGeometry.row-inset + 2px - root.height;
            width: parent.width;
            height: root.height - 2 * PanelGeometry.row-inset;
            border-radius: Metrics.radius-lg;
            background: Theme.shadow-color.with-alpha(0.08);
        }
    }

    VerticalLayout {
        // 卡片内容边距：固定几何，不随选中切换（行高稳定性
        // 不变量），与描边宽度无关；值计入 PanelGeometry.row-frame
        // （Rust 裁排经 preview-pad-h 读到）
        padding: PanelGeometry.row-inset;

        inner-card := Rectangle {
            border-radius: Metrics.radius-lg;
            // 行结构明暗同构：层底（card-layer）+ 浮起行卡（card-face，
            // 与设置窗分组卡共用同一 token），行区分靠亮度差 + 圆角 +
            // 卡缝。底色不设动画：键盘导航是高频交互，渐隐会让上一个
            // 选中项闪一拍强调色（Motion 频率纪律）。
            // 模糊形态玻璃卡（浮起层语言）：
            // 浅色白 70% / 深色白墨 5%，两态都是「比底更浅」的浮起层
            // （fg-default 随明暗反色，深色态即白墨）；实底形态保持
            // card-face 不透明
            background: blur-active
                ? (Theme.is-dark
                    ? Theme.fg-default.with-alpha(0.05)
                    : Theme.card-face.with-alpha(0.70))
                : Theme.card-face;

            // 悬停覆盖层：声明在内容之前垫底（选中无底色变化，
            // 强调全部由外层墨色边框 + 字重承载）；悬停 = 墨色微叠层
            Rectangle {
                border-radius: Metrics.radius-lg;
                background: item-ta.has-hover && !selected
                    ? Theme.fg-default.with-alpha(Theme.is-dark ? 0.06 : 0.04)
                    : transparent;
            }
            // 兜底裁剪：字体度量与渲染器行高存在细微差异时，
            // 防止预览文本画穿条目边界（原版由 CSS overflow 保证）
            clip: true;

            // 每行一把隐藏标尺：与预览 Text 同文本、同宽度，
            // 高度喂回预览 Text。布局引擎对换行文本的
            // 预选高度不反映字重加宽，溢出会把元信息行
            // 挤出卡片被裁掉——高度必须实测。
            // 字重固定 Metrics.weight-semibold：标尺若随选中切到 500，
            // 加粗文本比标尺宽，会多折一行把整行撑高
            // （预览串由 Rust 统一按重字重裁排，见 picker.rs measure-preview）
            preview-ruler := Text {
                opacity: 0;
                x: 0;
                y: 0;
                text: data.preview;
                font-size: Metrics.text-body;
                font-weight: Metrics.weight-semibold;
                wrap: word-wrap;
                width: preview-text.width;
            }

            VerticalLayout {
                padding-left: PanelGeometry.row-pad-left;
                padding-right: PanelGeometry.row-pad-right;
                padding-top: Metrics.space-2;
                padding-bottom: Metrics.space-2;
                spacing: Metrics.space-1_5;

                HorizontalLayout {
                    spacing: PanelGeometry.thumb-gap;
                    alignment: start;

                    if (data.has-thumb): Rectangle {
                        width: PanelGeometry.thumb-size;
                        height: PanelGeometry.thumb-size;
                        border-radius: Metrics.radius-md;
                        border-width: 1px;
                        border-color: selected ? Theme.border-default : Theme.border-subtle;
                        // 透明 PNG 周边的衬底（旧版 bg-canvas-default/subtle）
                        background: selected ? Theme.canvas-default : Theme.canvas-subtle;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: data.thumb;
                            image-fit: contain;
                        }
                    }

                    preview-text := Text {
                        text: data.preview;
                        // 正文恒 fg-default（微软列表正文 primary 档）：
                        // 大面积 secondary 灰在浅色下偏淡失神；收藏区分
                        // 由 ★ 星标承载，不再吃文字色档位
                        color: Theme.fg-default;
                        font-size: Metrics.text-body;
                        // 原版 line-clamp-4：预览串由 Rust 用度量标尺
                        // 按当前宽度裁到 4 行并加省略号
                        font-weight: selected ? Metrics.weight-semibold : Metrics.weight-medium;
                        wrap: word-wrap;
                        // 宽度显式固定（实例化处按 preview-width-* 传入），
                        // 不给布局按首选宽分配的机会
                        width: root.text-width;
                        // 高度取同行标尺实测（同文本/同字重/同宽度），
                        // 布局引擎的预选高度不反映字重加宽，不可依赖
                        height: min(82px, preview-ruler.height);
                        vertical-alignment: top;
                    }
                }

                // ── 元信息行 ──
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        horizontal-stretch: 1;

                        if (data.digit != ""): Rectangle {
                            height: 18px;
                            min-width: 18px;
                            border-radius: Metrics.radius-sm;
                            // 数字只是按键提示，不承载选择感（选择感由
                            // 外层墨色描边 + 选中字重承载）；底色与本行
                            // 类型 chip 同款静默档，选中仅提亮一档
                            background: selected
                                ? Theme.canvas-default
                                : (item-ta.has-hover ? Theme.canvas-inset : Theme.canvas-subtle);
                            HorizontalLayout {
                                padding-left: Metrics.space-1;
                                padding-right: Metrics.space-1;
                                Text {
                                    text: data.digit;
                                    // 恒 fg-muted：徽章底是 canvas 系深底，
                                    // fg-subtle 落上去跌破 4.5 对比度门禁
                                    color: Theme.fg-muted;
                                    font-size: Metrics.text-micro;
                                    font-weight: Metrics.weight-bold;
                                    font-family: "Consolas";
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 18px;
                            border-radius: Metrics.radius-sm;
                            background: selected ? Theme.canvas-default : Theme.canvas-inset;
                            HorizontalLayout {
                                padding-left: Metrics.space-1_5;
                                padding-right: Metrics.space-1_5;
                                Text {
                                    text: data.type-label;
                                    // 同数字徽章：canvas-inset 底上用 fg-muted 保对比度
                                    color: Theme.fg-muted;
                                    font-size: Metrics.text-meta;
                                    font-weight: Metrics.weight-medium;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: data.source-app;
                            color: selected ? Theme.fg-muted : Theme.fg-subtle;
                            font-size: Metrics.text-meta;
                            font-weight: Metrics.weight-medium;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        text: data.time-text;
                        color: selected ? Theme.fg-muted : Theme.fg-subtle;
                        font-size: Metrics.text-meta;
                        font-weight: Metrics.weight-medium;
                        vertical-alignment: center;
                    }

                    if (data.favorited): Text {
                        text: "★";
                        color: Theme.favorite;
                        font-size: selected ? 11px : 12px;
                        vertical-alignment: center;
                    }
                }

                // ── 标签行（最多 2 个 + 计数）──
                // 常显、不随选中切换：选中才渲染会让行高突增 26px、把下方
                // 行整体推动跳动；行高必须只由内容决定，与选中态无关
                if (data.tags.length > 0): HorizontalLayout {
                    spacing: Metrics.space-1;
                    alignment: start;
                    for tag-name in data.tags: Rectangle {
                        height: 20px;
                        border-radius: Metrics.radius-pill;
                        background: Theme.canvas-inset;
                        HorizontalLayout {
                            padding-left: Metrics.space-1_5;
                            padding-right: Metrics.space-1_5;
                            Text {
                                text: tag-name;
                                color: Theme.fg-muted;
                                font-size: Metrics.text-meta;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if (data.tag-more > 0): Text {
                        text: "+" + data.tag-more;
                        color: Theme.fg-subtle;
                        font-size: Metrics.text-meta;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // 选中描边：顶层向内重画，几何对齐 inner-card（外层减 padding
    // 双侧），画在内容之上、命中区之下，不参与布局——描边吃进
    // card-face 边缘内侧，卡片肉眼尺寸不随选中变化；圆角弧段
    // 不被 inner-card 的直角 clip 裁掉（slint#4176）。描边宽度的
    // 唯一声明处，改宽不动任何几何
    Rectangle {
        x: PanelGeometry.row-inset;
        y: PanelGeometry.row-inset;
        width: parent.width - 2 * PanelGeometry.row-inset;
        height: parent.height - 2 * PanelGeometry.row-inset;
        border-radius: Metrics.radius-lg;
        border-width: selected ? 2px : 0px;
        border-color: Theme.fg-default.with-alpha(0.70);
    }

    // 整行命中（含边框圈）：声明在内容之后以处于最上层，
    // 行内其余元素无自身交互
    item-ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        // 悬停追踪：pointer-event(move) 仅在按住时派发，
        // 纯悬停要监视自身 mouse-x/y 的变化。
        // 坐标换算成窗口内位置上报：tooltip 以面板原点
        // 定位（原版 clientX/Y），行内坐标会偏移整行位置
        changed mouse-x => {
            root.hover(self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
        changed mouse-y => {
            root.hover(self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
        changed has-hover => {
            if (!self.has-hover) {
                root.hover-left();
            }
        }
    }
}

export component QuickPasteWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "FloatPaste · 速贴";
    preferred-width: 360px;
    preferred-height: 420px;

    // ── 数据 ──
    in-out property <[ClipRow]> rows;
    in-out property <int> selected: 0;
    in-out property <string> empty-shortcut: "Ctrl+Q";
    in-out property <bool> digit-shortcuts-enabled: true;
    in-out property <bool> loading: false;
    in-out property <bool> load-failed: false;
    // 自绘模糊底图：DWM SystemBackdrop 的 Acrylic 模糊是激活态特权
    // （失活只剩半透明无模糊），速贴常态失活拿不到玻璃感；唤起时抓
    // 背后屏幕区域 CPU 模糊烘焙（core::backdrop），每次唤起重生成
    in property <image> blur-backdrop;
    in property <bool> blur-active: false;
    // 加载失败的具体原因（旧版 getErrorMessage 展示）
    in-out property <string> load-error-text;


    // ── 回调（Rust 接管）──
    callback row-clicked(int);
    callback row-double-clicked(int);
    callback row-hover(int, length, length);
    callback row-hover-left();
    // 头部拖拽移动（非模态手势：down 开始 / moved 增量移动 / up 结束）
    callback header-drag-started();
    callback header-drag-moved();
    callback header-drag-finished();
    // 顶栏关闭按钮（同 Esc 会话关闭路径）
    callback close-clicked();
    callback resize-started(int); // 0=N 1=S 2=W 3=E 4=NW 5=NE 6=SW 7=SE
    callback resize-moved();
    callback resize-finished();
    callback retry-clicked();
    // ── 预览排版几何（单一事实来源：slint 布局实测，Rust 只消费）──
    // 预览文本可用宽（逻辑 px）：由列表布局实测上报（flick 未实例化时
    // 为 0，Rust 首帧自行兜底——常量取自 PanelGeometry，上报后重裁修正）。
    // 裁排与渲染共用同一值，不再两边手抄几何公式
    out property <length> preview-width-no-thumb;
    out property <length> preview-width-thumb;
    callback preview-widths-changed();
    // 排版度量标尺：返回 text 在给定宽度下的排版高度（逻辑像素）。
    // 用 Slint 自己的排版引擎度量，与实际渲染天然一致。字重固定
    // Metrics.weight-semibold（标尺属性同值）：选中态行内 Text 在
    // 500↔600 间切换，按重字重裁排才能保证两态都不溢出预算
    callback measure-preview(string, length) -> length;
    measure-preview(text, width) => {
        measure-ruler.text = text;
        measure-ruler.width = width;
        measure-ruler.height
    }

    // 每次会话打开时把列表滚回顶部：Rust 递增该代数，列表区的监听元素重置滚动
    // （窗口经 hide/show 复用会保留滚动位置）
    in-out property <int> scroll-generation: 0;

    // 出现滑入：内容层从 4px 滑到位（与浮层进场语言一致的 150ms ease-out）。
    // 窗底（材质面）不动、只动内容——内容移开露出的区域是 card 自身底色，
    // 任何时刻都不露窗外，规避透明起步帧问题。Rust 侧时序：停屏期
    // enter-animated=false 重置 enter-offset → 暖首帧落盘起步态 → 上屏后
    // 解锁动画归零触发滑入
    in-out property <length> enter-offset: 0px;
    in-out property <bool> enter-animated: true;

    card := Rectangle {
        // 面板底双态：自绘模糊底图（blur-active，唤起时烘焙的不透明
        // 模糊+tint 图，圆角已烘焙进图 alpha——软渲 clip 不按圆角裁剪
        // slint#4176，靠图自身圆角规避）；抓屏失败/不支持回 card-layer
        // 层灰实底（浅 canvas-subtle 灰 / 深 canvas 近黑）。透明窗底不能
        // 裸透，两种形态都必须有底
        background: root.blur-active ? transparent : Theme.card-layer;
        border-radius: Metrics.radius-lg;
        border-width: PanelGeometry.card-border;
        border-color: Theme.border-window;
        clip: true;

        // 模糊底图铺底（z 序最底，画在内容之下）
        if root.blur-active : Image {
            source: root.blur-backdrop;
            width: 100%;
            height: 100%;
            image-fit: fill;
        }

        VerticalLayout {
            y: root.enter-offset;
            // 0ms 是进场动画关闭态占位（首帧直落），非时长档
            animate y { duration: root.enter-animated ? Motion.dur-enter : 0ms; easing: Motion.ease; }

            // ── 顶栏（图标 + 居中横条 + 关闭，可拖拽）──
            Rectangle {
                height: 30px;
                background: transparent;

                // 拖拽命中（声明在按钮之前 = 按钮点击优先）
                header-ta := TouchArea {
                    mouse-cursor: default;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.header-drag-started();
                        }
                        if (e.kind == PointerEventKind.up) {
                            root.header-drag-finished();
                        }
                    }
                    moved => {
                        root.header-drag-moved();
                    }
                }

                // 软件图标（32px 小尺寸规格源图，同 WindowTitleBar）
                Image {
                    x: 10px;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    source: @image-url("titlebar-icon.png");
                }

                // 居中拖拽横条（装饰性把手，悬停不加粗避免行高跳动）
                Rectangle {
                    x: (parent.width - 28px) / 2;
                    y: (parent.height - 3px) / 2;
                    width: 28px;
                    height: 3px;
                    border-radius: Metrics.radius-pill;
                    // border-default 为 border-subtle 与 fg 前景系之间的折中档
                    background: Theme.border-default;
                }

                // 关闭（hover 淡红底；12px X 与 WindowTitleBar 窗控同规格）
                btn-close := Rectangle {
                    x: parent.width - 46px;
                    width: 46px;
                    height: parent.height;
                    opacity: btn-close-ta.pressed ? 0.85 : 1.0;
                    background: btn-close-ta.has-hover ? Theme.danger-subtle : transparent;
                    btn-close-ta := TouchArea {
                        mouse-cursor: default;
                        clicked => { root.close-clicked(); }
                    }
                    Path {
                        x: (parent.width - 12px) / 2;
                        y: (parent.height - 12px) / 2;
                        width: 12px;
                        height: 12px;
                        viewbox-width: 12;
                        viewbox-height: 12;
                        stroke: Theme.fg-default;
                        stroke-width: 1px;
                        commands: "M 0.5 0.5 L 11.5 11.5 M 11.5 0.5 L 0.5 11.5";
                    }
                }
            }

            // ── 列表区 ──
            Rectangle {
                // 透出面板灰底：行卡白卡之间的缝隙与空态处见层灰
                background: transparent;
                border-radius: 8px;

                if (root.loading): VerticalLayout {
                    alignment: center;
                    Text {
                        text: "正在加载条目...";
                        color: Theme.fg-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
                if (!root.loading && root.load-failed): VerticalLayout {
                    alignment: center;
                    padding: 32px;
                    spacing: Metrics.space-1_5;
                    Text {
                        text: "条目加载失败";
                        color: Theme.fg-muted;
                        font-size: Metrics.text-sm;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.load-error-text;
                        color: Theme.fg-subtle;
                        font-size: Metrics.text-xs;
                        horizontal-alignment: center;
                    }
                    retry := Rectangle {
                        border-radius: Metrics.radius-lg;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        height: 30px;
                        horizontal-stretch: 0;
                        opacity: retry-ta.pressed ? 0.85 : 1.0;
                        background: retry-ta.has-hover ? Theme.canvas-subtle : transparent;
                        animate background { duration: Motion.dur-color; easing: Motion.ease; }
                        retry-ta := TouchArea {
                            clicked => { root.retry-clicked(); }
                        }
                        HorizontalLayout {
                            padding-left: Metrics.space-3;
                            padding-right: Metrics.space-3;
                            alignment: center;
                            Text {
                                text: "重试";
                                color: retry-ta.has-hover ? Theme.fg-default : Theme.fg-muted;
                                font-size: Metrics.text-xs;
                                font-weight: Metrics.weight-medium;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if (!root.loading && !root.load-failed && root.rows.length == 0): VerticalLayout {
                    alignment: center;
                    spacing: Metrics.space-1;
                    Text {
                        text: "暂无剪贴板条目";
                        color: Theme.fg-muted;
                        font-size: Metrics.text-sm;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "复制内容后按 " + root.empty-shortcut + " 打开此面板";
                        color: Theme.fg-subtle;
                        font-size: Metrics.text-xs;
                        horizontal-alignment: center;
                    }
                }
                if (!root.loading && !root.load-failed && root.rows.length > 0): Rectangle {
                    // Flickable 显式几何（不进布局）：右侧预留滚动槽，
                    // 原版 grid: pl-[14px] pr-1 gap-1 py-1.5
                    flick := Flickable {
                        x: 0;
                        y: 0;
                        width: parent.width - PanelGeometry.scroll-slot;
                        height: parent.height;
                        interactive: true;
                        // 实测上报预览可用宽：flick 宽扣 PanelGeometry.
                        // preview-pad-h（列表内边距 + 卡片内容边距 +
                        // 行内边距），含缩略图列再扣缩略图列宽。窗口
                        // 缩放联动 changed width，重裁由回调驱动
                        function report-preview-widths() {
                            root.preview-width-no-thumb = self.width - PanelGeometry.preview-pad-h;
                            root.preview-width-thumb = root.preview-width-no-thumb
                                - PanelGeometry.thumb-size - PanelGeometry.thumb-gap;
                            root.preview-widths-changed();
                        }
                        init => { self.report-preview-widths(); }
                        changed width => { self.report-preview-widths(); }

                        VerticalLayout {
                            // 原版 grid: pl-[14px] pr-1 gap-1 py-1.5
                            padding-left: PanelGeometry.list-pad-left;
                            padding-right: PanelGeometry.list-pad-right;
                            padding-top: Metrics.space-1_5;
                            padding-bottom: Metrics.space-1_5;
                            spacing: Metrics.space-1;

                            for row[i] in root.rows: ClipRowCard {
                                data: row;
                                selected: i == root.selected;
                                blur-active: root.blur-active;
                                text-width: row.has-thumb
                                    ? root.preview-width-thumb
                                    : root.preview-width-no-thumb;
                                clicked => { root.row-clicked(i); }
                                double-clicked => { root.row-double-clicked(i); }
                                hover(x, y) => { root.row-hover(i, x, y); }
                                hover-left => { root.row-hover-left(); }
                                scroll-into-view(row-y, row-height) => {
                                    if (row-y < -flick.content-y + 6px) {
                                        flick.content-y = -row-y + 6px;
                                    } else if (row-y + row-height > -flick.content-y + flick.height - 6px) {
                                        flick.content-y = -(row-y + row-height - flick.height + 6px);
                                    }
                                }
                            }
                        }
                    }

                    // ── 滚动条（绝对定位不进布局）──
                    if (flick.content-height > flick.height): ListScrollBar {
                        x: parent.width - PanelGeometry.scroll-slot;
                        y: 0;
                        width: PanelGeometry.scroll-slot;
                        height: parent.height;
                        content-height: flick.content-height;
                        visible-height: flick.height;
                        content-y <=> flick.content-y;
                    }

                    // 会话打开时滚回顶部（监听代数属性；changed 只能挂在本元素属性上）
                    Rectangle {
                        visible: false;
                        property <int> generation: root.scroll-generation;
                        changed generation => {
                            flick.content-y = 0;
                        }
                    }
                }
            }
        }

        // ── 拉伸手柄（最顶层，几何对齐原版 PICKER_RESIZE_HANDLES）──
        // 北向两条（避开顶部中央拖拽区；右条右缘让位右上关闭按钮）
        ResizeHandle {
            direction: 0;
            x: 12px;
            y: 0;
            width: (parent.width - 24px) / 2 - 36px;
            height: 8px;
            started => { root.resize-started(0); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 0;
            x: 12px + (parent.width - 24px) / 2 + 36px;
            y: 0;
            // 右缘止于关闭按钮左缘（46px 按钮区不响应拉伸，同原生窗控）
            width: (parent.width - 24px) / 2 - 36px - 34px;
            height: 8px;
            started => { root.resize-started(0); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 1;
            x: 12px;
            y: parent.height - 8px;
            width: parent.width - 24px;
            height: 8px;
            started => { root.resize-started(1); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 2;
            x: 0;
            y: 12px;
            width: 4px;
            height: parent.height - 24px;
            started => { root.resize-started(2); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 3;
            x: parent.width - 4px;
            y: 12px;
            width: 4px;
            height: parent.height - 24px;
            started => { root.resize-started(3); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 4;
            x: 0;
            y: 0;
            width: 16px;
            height: 16px;
            started => { root.resize-started(4); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 5;
            // NE 角让位右上关闭按钮，退守按钮左侧（原 width-16px 位置
            // 整块落在按钮命中区内，点击会变拉伸而非关闭）
            x: parent.width - 46px - 16px;
            y: 0;
            width: 16px;
            height: 16px;
            started => { root.resize-started(5); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 6;
            x: 0;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
            started => { root.resize-started(6); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }
        ResizeHandle {
            direction: 7;
            x: parent.width - 16px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
            started => { root.resize-started(7); }
            drag-moved => { root.resize-moved(); }
            finished => { root.resize-finished(); }
        }

        // ── 排版度量标尺：与列表预览同款排版属性，不可见不挡输入 ──
        measure-ruler := Text {
            opacity: 0;
            x: 0;
            y: 0;
            width: 0px;
            text: "";
            font-size: Metrics.text-body;
            font-weight: Metrics.weight-semibold;
            wrap: word-wrap;
        }
    }
}
