// 搜索窗口：对齐原版 SearchShell.tsx 的完整复刻。
// - 无边框不透明窗（方角 + 1px 窗口边框 + DWM 阴影由 Rust 侧处理），
//   宽度固定 780，高度由 Rust 按内容棘轮同步（min(620, chrome+列表)）
// - 头部：放大镜 + 输入框（17px/24px 行高）+ 清除按钮 + 条目计数，背景可拖拽移动
// - 筛选行：类型 chips（全部/收藏/文本/图片/文件）+ 标签 chips（多选 AND）
// - 列表：单行省略恒定行高，选中仅高亮/左条/操作条浮层（不展开全文与大图）
// - 键盘：根 FocusScope capture-key-pressed 先于输入框拦截会话键
//   （↑↓/Enter/Shift+Enter/Ctrl+Enter/Ctrl+Space/Del/Esc），其余按键放行输入框
// - 挂起态（键盘交给速贴面板）：输入框失焦、底栏切换为速贴键位提示
// - 行高恒定：选中只换高亮/左条/操作条浮层，不展开（切换零跳动，用户要求）
import { Theme, Metrics } from "theme.slint";
import { Kbd } from "common.slint";
import { ListScrollBar } from "picker.slint";

export struct SearchRow {
    id: string,
    // 单行省略形态（换行已由 Rust 折为空格）。行高恒定不随选中变化
    preview: string,
    kind: int, // 0=text 1=image 2=file
    source-app: string,
    time-text: string,
    meta: string, // 已用 " • " 连接的元信息串
    favorited: bool,
    has-thumb: bool,
    thumb: image,
    tags: [string],
    tag-more: int,
}

export struct SearchTagChip {
    name: string,
    active: bool,
}

// ── 结构几何：slint 布局与 Rust 高度同步/裁排共用的常量，禁双边手抄 ──
export global SearchGeometry {
    out property <length> window-width: 780px;
    out property <length> window-max-height: 620px;
    // 旧版 chromeHeight = 5 + 头部 + 错误条 + 筛选行 + 底栏
    out property <length> height-slack: 5px;
    out property <length> window-border: 1px;
    out property <length> scroll-slot: 10px;
    // 列表内容包裹层（wrapper px-0.5 + inner px-1 / pt-1.5+pt-0.5 / pb-1+pb-1）
    out property <length> content-pad-h: 6px;
    out property <length> content-pad-top: 8px;
    out property <length> content-pad-bottom: 8px;
    out property <length> row-border-l: 2px;
    out property <length> row-pad-h: 12px;
    out property <length> thumb-size: 36px;
    out property <length> thumb-gap: 12px;
    // 触底预载距离（旧版 SEARCH_LOAD_MORE_ROOT_MARGIN_PX）
    out property <length> load-more-margin: 240px;
}

// ── 1.8px 线性图标路径（viewbox 24，路径与旧版 svg 同源）──
// Slint 只按视框缩放几何、不缩放 stroke-width：1.8@24 在 18px 下
// 等效 1.35px，必须显式折算，否则笔画比旧版（浏览器）粗一半且发糊
component GlyphPath inherits Path {
    in property <color> glyph-color;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.glyph-color;
    stroke-width: 1.35px;
    fill: transparent;
}

// ── 方形图标按钮（操作条内），图标经 @children 传入 ──
// armed：两段式删除确认态——加宽并常驻危险底色（对齐旧壳
// actionButtonDanger 的 h-7 px-2 自适应宽 + armed 底色），文案由调用方传入
component IconButton inherits Rectangle {
    in property <color> icon-color;
    in property <bool> danger-hover: false;
    in property <bool> armed: false;
    // 静态提示文案（悬停经悬浮气泡显示，空串 = 无提示）
    in property <string> hint;
    callback clicked();
    callback hover(string, length, length);
    callback hover-left();
    // 悬停命中变化上报 + 当前命中外读：行卡片汇总所有命中区判定操作条显隐
    // （按钮 TouchArea 在最上层，行背景/操作条间隙在此刻都无命中，
    //  不上报会把操作条误判为非悬停而隐藏）
    callback hover-changed();
    out property <bool> pointer-hover: btn-ta.has-hover;

    width: root.armed ? 64px : 28px;
    height: 28px;
    border-radius: Metrics.radius-md;
    // 悬停底色用前景墨半透明叠层（暗色≈提亮、亮色≈压暗）：与行悬停底
    // canvas-subtle 同源会几乎不可见，PowerToys Run 同款悬停语言
    background: root.armed ? Theme.danger-subtle
        : (btn-ta.has-hover
            ? (root.danger-hover ? Theme.danger-subtle : Theme.fg-default.with-alpha(0.1))
            : transparent);
    // 危险悬停时图标同步转危险色（旧版 hover:text-pg-danger-fg）
    out property <color> glyph-color: btn-ta.has-hover && root.danger-hover
        ? Theme.danger-fg : root.icon-color;
    // 旧版 actionButton 的 transition-colors：底色渐变而非瞬变
    animate background { duration: 120ms; easing: ease-out; }

    // 图标直接作为 Rectangle 子元素走“默认 y = 居中”规则；若套布局，
    // 固定高图标会被交叉轴顶对齐而整体偏高
    @children

    btn-ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            root.hover-changed();
            // 提示锚点取按钮下方，气泡稳定悬于按钮之下而非跟随鼠标
            if (self.has-hover && root.hint != "") {
                root.hover(root.hint,
                    self.absolute-position.x,
                    self.absolute-position.y + self.height + 4px);
            } else {
                root.hover-left();
            }
        }
    }
}

component KeyHint inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    spacing: 4px;
    // 布局交叉轴对固定高子元素是顶对齐：包一层拉伸容器，
    // 让 Kbd 走“默认 y = 居中”规则与右侧文案垂直居中对齐
    Rectangle {
        Kbd { key: root.key; }
    }
    Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: Metrics.text-hint;
        vertical-alignment: center;
    }
}

// 类型筛选 chip（rounded-md px-2.5 py-1 text-xs）
component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 24px;
    border-radius: Metrics.radius-md;
    background: root.active ? Theme.accent-subtle
        : (chip-ta.has-hover ? Theme.canvas-subtle : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: root.active ? Theme.accent-fg
                : (chip-ta.has-hover ? Theme.fg-default : Theme.fg-muted);
            font-size: Metrics.text-xs;
            font-weight: Metrics.weight-medium;
            vertical-alignment: center;
        }
    }
    chip-ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 标签筛选 chip（胶囊，多选 AND）
component TagChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 24px;
    border-radius: Metrics.radius-pill;
    background: root.active ? Theme.accent-subtle
        : (chip-ta.has-hover ? Theme.canvas-subtle : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: root.active ? Theme.accent-fg
                : (chip-ta.has-hover ? Theme.fg-default : Theme.fg-muted);
            font-size: Metrics.text-xs;
            vertical-alignment: center;
        }
    }
    chip-ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 条目类型图标（36×36 底座内 18×18，对齐旧版 ClipTypeIcon）
component TypeGlyph inherits Rectangle {
    in property <int> kind; // 0=text 1=image 2=file
    in property <color> glyph-color;
    width: 18px;
    height: 18px;

    if (root.kind == 0): Rectangle {
        // 文本：三横线（M5 6.25h14 M5 11h11 M5 15.75h14，×0.75 后线心 4.69/8.25/11.81）
        x: 3.75px; y: 4px; width: 10.5px; height: 1.4px; background: root.glyph-color;
    }
    if (root.kind == 0): Rectangle {
        x: 3.75px; y: 7.55px; width: 8.25px; height: 1.4px; background: root.glyph-color;
    }
    if (root.kind == 0): Rectangle {
        x: 3.75px; y: 11.1px; width: 10.5px; height: 1.4px; background: root.glyph-color;
    }

    if (root.kind == 1): GlyphPath {
        glyph-color: root.glyph-color;
        // 相框（rx2.5 圆角）+ 双山（与旧版 image svg 同源，含山尖圆弧）
        commands: "M 5.5 5 L 18.5 5 A 2.5 2.5 0 0 1 21 7.5 L 21 16.5 A 2.5 2.5 0 0 1 18.5 19 L 5.5 19 A 2.5 2.5 0 0 1 3 16.5 L 3 7.5 A 2.5 2.5 0 0 1 5.5 5 Z M 5 16 L 9.2 11.8 A 1.5 1.5 0 0 1 11.3 11.8 L 15 15.5 M 13 13 L 14.7 11.3 A 1.5 1.5 0 0 1 16.8 11.3 L 21 15.5";
    }
    if (root.kind == 1): Rectangle {
        // 太阳点（旧版 circle cx9 cy9.5 r1.2，×0.75 → 圆心 6.75,7.125 r0.9）
        x: 5.85px; y: 6.23px; width: 1.8px; height: 1.8px;
        border-radius: Metrics.radius-pill;
        background: root.glyph-color;
    }

    if (root.kind == 2): GlyphPath {
        glyph-color: root.glyph-color;
        // 折角文档（旧版 file svg）
        commands: "M 6 3.75 L 13 3.75 L 18.25 9 L 18.25 20.25 L 6 20.25 Z M 13 3.75 L 13 9 L 18.25 9";
    }
}

// ── 行卡片：恒定行高；选中只换高亮/左条/操作条浮层，不展开 ──
component SearchRowCard inherits Rectangle {
    in property <SearchRow> data;
    in property <bool> selected;
    in property <length> preview-width; // 基础预览宽（未扣选中预留/未扣 pr-1）
    in property <bool> delete-armed;
    callback clicked();
    callback double-clicked();
    callback hover(length, length);
    callback hover-left();
    callback button-hint(string, length, length);
    callback button-hint-left();
    callback paste();
    callback paste-as-path();
    callback edit();
    callback toggle-favorite();
    callback delete-armed-request();
    callback scroll-into-view(length, length);

    // 事件驱动悬停态：行背景 / 操作条间隙 / 各图标按钮互斥命中，
    // 任一 has-hover 变化都从当前实际命中重算，与回调触发顺序无关。
    // 操作条显隐依赖 hovered，任一命中区漏报都会让操作条在移入
    // 按钮瞬间被误判离开而消失
    property <bool> hovered: false;
    function sync-hover() {
        root.hovered = row-ta.has-hover || act-ta.has-hover
            || paste-btn.pointer-hover || sec-btn.pointer-hover
            || fav-btn.pointer-hover || del-btn.pointer-hover;
        if (!root.hovered) {
            root.hover-left();
        }
    }
    property <bool> is-selected: selected;
    // 右列纵向排布链。行高恒定（不随选中展开）：切换选中时下方行
    // 才不会被推挤跳动（用户要求；选中只换高亮/左条/操作条浮层）
    property <length> preview-h: 24px;
    property <length> meta-y: root.preview-h + 2px;
    property <length> meta-h: meta-ruler.height;
    property <bool> tags-shown: data.tags.length > 0;
    property <length> tags-y: root.meta-y + root.meta-h + 4px;
    property <length> tags-h: 18px;
    property <length> col-height: root.tags-y + (root.tags-shown ? root.tags-h : 0px);

    height: 20px + root.col-height;

    changed is-selected => {
        if (self.is-selected) {
            self.scroll-into-view(self.y, self.height);
        }
    }

    border-radius: Metrics.radius-lg;
    // hover 底恒定半透明：材质时透 backdrop，无材质时叠窗底实色（观感
    // 仅略淡，无害）——省去向行组件穿材质门控
    background: root.selected ? Theme.accent-subtle
        : (root.hovered ? Theme.canvas-subtle.with-alpha(0.62) : transparent);

    // 选中态左侧 2px 强调边（旧版 border-l-pg-accent-fg）。浏览器里
    // border-left 沿圆角转折，Slint 的 clip 只按矩形裁：底层铺整卡
    // 强调色作"边"，其上右移 2px 垫不透明底色再上半透明高亮，露出的
    // 左缘即贴合圆角的 2px 边。accent-subtle 是半透明色，直接叠在
    // 强调色上会透成亮蓝，必须先垫不透明的 canvas 底
    Rectangle {
        visible: root.selected;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Metrics.radius-lg;
        background: Theme.accent-fg;
    }
    Rectangle {
        visible: root.selected;
        x: 2px;
        y: 0;
        width: root.width - 2px;
        height: root.height;
        border-radius: Metrics.radius-lg;
        background: Theme.canvas-default;
    }
    Rectangle {
        visible: root.selected;
        x: 2px;
        y: 0;
        width: root.width - 2px;
        height: root.height;
        border-radius: Metrics.radius-lg;
        background: Theme.accent-subtle;
    }

    // 整行命中（声明在前处于最上层内容之下）
    row-ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        changed mouse-x => {
            root.hover(self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
        changed mouse-y => {
            root.hover(self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
        changed has-hover => { root.sync-hover(); }
    }

    // ── 行主体（py-2.5 pl-3 pr-3 gap-3）──
    // 图标底座与右列均绝对定位（右列子元素全为绝对定位、无首选宽，
    // 交给布局推断会得到错误的摆位），几何全部显式化。
    // 图标列（图片缩略图或类型图标底座）恒占 thumb-size + gap 宽
    property <length> col-x: SearchGeometry.row-border-l + SearchGeometry.row-pad-h;
    // 上报的 preview-width 已扣除图标列，这里直接就是右列宽
    property <length> col-w: root.preview-width;
    // 操作条显出时右列文本的让位宽度（对齐 PowerToys Run：激活行文字
    // 重排给按钮区让位）。操作条右缘越出列右缘 2px（外层右距 10px <
    // 行右距 12px），再留 4px 呼吸空隙；随删除确认键加宽自动增长
    property <length> bar-reserve: (root.selected || root.hovered)
        ? action-bar.width + 2px : 0px;

    if (data.has-thumb): Rectangle {
        x: SearchGeometry.row-border-l + SearchGeometry.row-pad-h;
        y: 10px;
        width: SearchGeometry.thumb-size;
        height: SearchGeometry.thumb-size;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: root.selected ? Theme.border-default : Theme.border-subtle;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: data.thumb;
            image-fit: cover;
        }
    }
    if (!data.has-thumb): Rectangle {
        x: SearchGeometry.row-border-l + SearchGeometry.row-pad-h;
        y: 10px;
        width: SearchGeometry.thumb-size;
        height: SearchGeometry.thumb-size;
        border-radius: Metrics.radius-md;
        background: Theme.canvas-inset;
        TypeGlyph {
            kind: data.kind;
            // 非选中行悬停时图标变亮（旧版 group-hover:text-pg-fg-default）
            glyph-color: (root.selected || root.hovered)
                ? Theme.fg-default : Theme.fg-muted;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    // ── 右列：预览 + 元信息 + 标签（绝对定位纵排链）──
    Rectangle {
        x: root.col-x + SearchGeometry.thumb-size + SearchGeometry.thumb-gap;
        y: 10px;
        width: root.col-w;
        height: root.col-height;

            // 单行省略（旧版 truncate pr-1，常规字重）
            Text {
                x: 0;
                y: 0;
                height: 24px;
                width: root.col-w - 4px - root.bar-reserve;
                text: data.preview;
                color: Theme.fg-default;
                font-size: 15px;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
            }

            // 元信息行（mt-0.5 text-xs fg-subtle）。让位定宽裁剪：变窄后
            // 多折出的整行落在 meta-h 之外被整行裁掉，不会截半行；行高
            // 仍由全宽标尺实测（恒定行高）
            Rectangle {
                x: 0;
                y: root.meta-y;
                width: root.col-w - root.bar-reserve;
                height: root.meta-h;
                clip: true;
                Text {
                    width: parent.width;
                    text: data.meta;
                    color: Theme.fg-subtle;
                    font-size: Metrics.text-xs;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
                // 首行宽度实测：收藏星标内联跟随文字末尾（对齐速贴窗
                // 时间行末尾的星标），元信息超行时退到首行右缘
                meta-line-ruler := Text {
                    opacity: 0;
                    text: data.meta;
                    font-size: Metrics.text-xs;
                    wrap: no-wrap;
                }
                if (data.favorited): Text {
                    x: min(meta-line-ruler.width + 6px, parent.width - self.width);
                    y: 0;
                    // 盒高取标尺自然高（= 首行真实行高），星标与首行
                    // 同一行框内居中，避免写死像素对不齐
                    height: meta-line-ruler.height;
                    text: "★";
                    color: Theme.favorite;
                    font-size: root.selected ? 11px : 12px;
                    vertical-alignment: center;
                }
            }

            // 标签行（mt-1，最多 3 个 + 溢出计数）
            Rectangle {
                visible: root.tags-shown;
                x: 0;
                y: root.tags-y;
                height: root.tags-h;
                width: root.col-w - root.bar-reserve;
                clip: true;
                HorizontalLayout {
                    spacing: Metrics.space-1;
                    alignment: start;
                    for tag-name in data.tags: Rectangle {
                        height: 18px;
                        border-radius: Metrics.radius-pill;
                        background: Theme.canvas-inset;
                        HorizontalLayout {
                            padding-left: Metrics.space-1_5;
                            padding-right: Metrics.space-1_5;
                            Text {
                                text: tag-name;
                                color: Theme.fg-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if (data.tag-more > 0): Text {
                        text: "+" + data.tag-more;
                        color: Theme.fg-subtle;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // 元信息标尺：元信息可能折行，高度实测
            meta-ruler := Text {
                opacity: 0;
                x: 0;
                y: 0;
                text: data.meta;
                font-size: Metrics.text-xs;
                wrap: word-wrap;
                width: root.col-w;
            }
    }

    // ── 操作条（PowerToys Run 语言：裸图标组直接浮在行上，无卡片包裹；
    // 选中与悬停显示同一组按钮）──
    Rectangle {
        visible: root.selected || root.hovered;
        // 悬停出现淡入（旧版 hoverPasteButton 的 transition-opacity）
        opacity: (root.selected || root.hovered) ? 1.0 : 0.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        clip: false;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: end;
                padding-right: 10px;

                action-bar := Rectangle {
                    height: 32px; // p-0.5 + h-7 按钮

                    // 按钮间隙命中：挡住行级点击并上报悬停
                    act-ta := TouchArea {
                        clicked => { }
                        changed has-hover => { root.sync-hover(); }
                    }

                    HorizontalLayout {
                        padding: 2px;
                        spacing: Metrics.space-1;

                        // 粘贴：PowerToys Run 首位动作的双叠圆角方块图形
                        paste-btn := IconButton {
                            icon-color: Theme.fg-default;
                            hint: "粘贴（Enter）";
                            clicked => { root.paste(); }
                            hover(t, x, y) => { root.button-hint(t, x, y); }
                            hover-left => { root.button-hint-left(); }
                            hover-changed => { root.sync-hover(); }
                            Path {
                                width: 16px;
                                height: 16px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: paste-btn.icon-color;
                                stroke-width: 1.2px;
                                commands: "M 8 10 A 2 2 0 0 1 10 8 L 20 8 A 2 2 0 0 1 22 10 L 22 18 A 2 2 0 0 1 20 20 L 10 20 A 2 2 0 0 1 8 18 Z M 4 16 A 2 2 0 0 1 2 14 L 2 4 A 2 2 0 0 1 4 2 L 14 2 A 2 2 0 0 1 16 4";
                            }
                        }
                        // 第二键随类型切换：文本行=编辑内容；图片/文件行=
                        // 次级上屏（把所在路径作为文本上屏）。图标与类型
                        // 图标同源——图片=相框+双山、文件=折角文档
                        sec-btn := IconButton {
                            icon-color: Theme.fg-default;
                            hint: data.kind == 0
                                ? "编辑内容（Ctrl+Enter）"
                                : (data.kind == 1
                                    ? "粘贴为图片路径（Shift+Enter）"
                                    : "粘贴为文件路径（Shift+Enter）");
                            clicked => {
                                if (data.kind == 0) {
                                    root.edit();
                                } else {
                                    root.paste-as-path();
                                }
                            }
                            hover(t, x, y) => { root.button-hint(t, x, y); }
                            hover-left => { root.button-hint-left(); }
                            hover-changed => { root.sync-hover(); }
                            Path {
                                width: 16px;
                                height: 16px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: Theme.fg-default;
                                stroke-width: 1.2px;
                                commands: data.kind == 0
                                    ? "M 4.75 19.25 L 8.25 19.25 L 18.5 9 L 15 5.5 L 4.75 15.75 L 4.75 19.25 Z M 13.75 6.75 L 17.25 10.25 M 4.75 19.25 L 8 19.2"
                                    : (data.kind == 1
                                        ? "M 5.5 5 L 18.5 5 A 2.5 2.5 0 0 1 21 7.5 L 21 16.5 A 2.5 2.5 0 0 1 18.5 19 L 5.5 19 A 2.5 2.5 0 0 1 3 16.5 L 3 7.5 A 2.5 2.5 0 0 1 5.5 5 Z M 5 16 L 9.2 11.8 A 1.5 1.5 0 0 1 11.3 11.8 L 15 15.5 M 13 13 L 14.7 11.3 A 1.5 1.5 0 0 1 16.8 11.3 L 21 15.5"
                                        : "M 6 3.75 L 13 3.75 L 18.25 9 L 18.25 20.25 L 6 20.25 Z M 13 3.75 L 13 9 L 18.25 9");
                            }
                        }
                        fav-btn := IconButton {
                            icon-color: data.favorited ? Theme.favorite : Theme.fg-default;
                            hint: data.favorited ? "取消收藏（Ctrl+Space）" : "收藏（Ctrl+Space）";
                            clicked => { root.toggle-favorite(); }
                            hover(t, x, y) => { root.button-hint(t, x, y); }
                            hover-left => { root.button-hint-left(); }
                            hover-changed => { root.sync-hover(); }
                            Path {
                                width: 16px;
                                height: 16px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: fav-btn.icon-color;
                                stroke-width: 1.2px;
                                fill: data.favorited ? Theme.favorite : transparent;
                                commands: "M 12 3.85 L 14.55 9.02 L 20.26 9.85 L 16.13 13.88 L 17.11 19.57 L 12 16.89 L 6.89 19.57 L 7.87 13.88 L 3.74 9.85 L 9.45 9.02 Z";
                            }
                        }
                        del-btn := IconButton {
                            armed: root.delete-armed;
                            icon-color: root.delete-armed ? Theme.danger-fg : Theme.fg-muted;
                            danger-hover: true;
                            hint: "删除（Del）";
                            clicked => { root.delete-armed-request(); }
                            hover(t, x, y) => { root.button-hint(t, x, y); }
                            hover-left => { root.button-hint-left(); }
                            hover-changed => { root.sync-hover(); }
                            if (root.delete-armed): HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "确认删除";
                                    color: del-btn.icon-color;
                                    font-size: Metrics.text-xs;
                                    font-weight: Metrics.weight-medium;
                                    vertical-alignment: center;
                                }
                            }
                            if (!root.delete-armed): Path {
                                width: 16px;
                                height: 16px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: del-btn.glyph-color;
                                stroke-width: 1.2px;
                                commands: "M 4 7 L 20 7 M 9.5 4.75 L 14.5 4.75 L 14.5 7 L 9.5 7 Z M 6.5 7 L 7.3 19.25 L 16.7 19.25 L 17.5 7 M 10 10.5 L 10 16.5 M 14 10.5 L 14 16.5";
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SearchWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: true;
    title: "FloatPaste · 搜索";
    preferred-width: 780px;
    preferred-height: 420px;

    // ── 数据（Rust 接管）──
    in-out property <[SearchRow]> rows;
    in-out property <int> selected: 0;
    in-out property <string> keyword;
    in-out property <bool> input-suspended: false;
    in-out property <bool> loading: false;
    in-out property <bool> load-failed: false;
    // 加载失败的具体原因（旧版 getErrorMessage 展示）
    in-out property <string> load-error-text;
    in-out property <bool> show-result-count: true;
    in-out property <int> result-count: 0;
    in-out property <int> result-total: 0;
    in-out property <string> error-text;
    // 两段式删除待确认行号（-1 = 无）：悬停行与选中行都可发起删除，
    // 待确认标记只落在发起行上，不会同时染到其他行的操作条
    in-out property <int> delete-armed-row: -1;
    in-out property <bool> has-next-page: false;
    in-out property <bool> fetching-next: false;
    in-out property <[SearchTagChip]> tag-chips;
    in-out property <int> active-filter: 0; // 0=全部 1=收藏 2=文本 3=图片 4=文件
    // 空状态：标题/描述/动作（0=无 1=清除关键词 2=清除筛选）
    in-out property <string> empty-title;
    in-out property <string> empty-description;
    in-out property <int> empty-action: 0;
    // 每次会话打开滚回顶部
    in-out property <int> scroll-generation: 0;
    // DWM 材质挂载成功与否：false 时面板用不透明底回退
    in property <bool> material-active: false;

    // 出现滑入：内容层从 4px 滑到位（与浮层进场语言一致的 150ms ease-out）。
    // 窗底（材质面）不动、只动内容——内容移开露出的区域是 panel 自身底色，
    // 任何时刻都不露窗外，规避透明起步帧问题。Rust 侧时序：停屏期
    // enter-animated=false 重置 enter-offset → 暖首帧落盘起步态 → 上屏后
    // 解锁动画归零触发滑入
    in-out property <length> enter-offset: 0px;
    in-out property <bool> enter-animated: true;

    // ── 回调（Rust 接管）──
    callback keyword-edited(string);
    callback clear-keyword();
    callback filter-selected(int);
    callback tag-toggled(int);
    callback clear-filters();
    callback retry-clicked();
    callback row-clicked(int);
    callback row-double-clicked(int);
    callback row-hover(int, length, length);
    callback row-hover-left();
    // 图标按钮静态提示（悬浮气泡 simple 模式）：文案/锚点由按钮给出
    callback button-hint(string, length, length);
    callback button-hint-left();
    callback action-paste(int);
    callback action-paste-as-path(int);
    callback action-edit(int);
    callback action-toggle-favorite(int);
    callback action-delete(int);
    callback key-navigate-up();
    callback key-navigate-down();
    callback key-paste(bool); // shift=次级上屏（粘贴为路径）
    callback key-edit();
    callback key-toggle-favorite();
    callback key-delete();
    callback key-close();
    // 会话键位判定（Rust 侧按设置解析）：入参 = 事件文本 + 四修饰键，
    // 返回动作码（见 capture-key-pressed 注释）
    callback resolve-session-action(string, bool, bool, bool, bool) -> int;
    callback near-bottom();
    callback drag-started();
    callback drag-moved();
    callback drag-finished();
    callback heights-changed();

    // ── 预览可用宽（列表布局实测上报，Rust 只消费）──
    out property <length> preview-width-no-thumb;
    out property <length> preview-width-thumb;
    // ── 高度同步度量（旧版：target = min(620, 5 + chrome + 列表内容高)）──
    out property <length> chrome-height:
        header-bar.height + (error-bar.visible ? error-bar.height : 0px)
        + filter-bar.height + footer-bar.height;
    out property <length> list-content-height: list-stack.natural-height;

    public function focus-input() {
        search-input.focus();
    }
    public function blur-input() {
        key-scope.focus();
    }

    key-scope := FocusScope {
        // 键盘会话：capture 阶段先于输入框消费会话键（对齐旧版 window 级
        // keydown + preventDefault）。键位判定在 Rust 侧按当前设置解析
        // （resolve-session-action 动作码：1=向上 2=向下 3=上屏 4=次级
        // 上屏（粘贴为路径） 5=编辑 6=收藏 7=关闭 8=删除，0=放行），其余
        // 按键 reject 放行给输入框
        capture-key-pressed(event) => {
            let action = root.resolve-session-action(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta,
            );
            if (action == 7) {
                root.key-close();
                return accept;
            }
            if (root.input-suspended) {
                // 挂起态：键盘已交给速贴面板（原生由 LL 钩子全局接管，
                // 窗口内只剩兜底关闭键）
                return reject;
            }
            if (action == 1) {
                root.key-navigate-up();
                return accept;
            }
            if (action == 2) {
                root.key-navigate-down();
                return accept;
            }
            if (action == 5) {
                root.key-edit();
                return accept;
            }
            if (action == 4) {
                root.key-paste(true);
                return accept;
            }
            if (action == 3) {
                root.key-paste(false);
                return accept;
            }
            if (action == 8) {
                root.key-delete();
                return accept;
            }
            if (action == 6) {
                root.key-toggle-favorite();
                return accept;
            }
            return reject;
        }

        panel := Rectangle {
            // 整窗近实心层（Acrylic 透出压到 ~10%）：前景脚下不渗噪点，
            // 材质感以低透保留——对齐 PowerToys Run 的实底浮层语言
            background: root.material-active ? Theme.material-layer : Theme.canvas-default;
            border-width: SearchGeometry.window-border;
            border-color: Theme.border-window;
            clip: true;

            VerticalLayout {
                y: root.enter-offset;
                animate y { duration: root.enter-animated ? 150ms : 0ms; easing: ease-out; }

                // ── 头部（背景可拖拽；px-4 py-3 gap-3）──
                header-bar := Rectangle {
                    height: 56px;
                    // 透出 panel 的材质底（原 canvas-default 形成不透明色带）
                    background: transparent;

                    header-ta := TouchArea {
                        mouse-cursor: default;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.drag-started();
                            }
                            if (e.kind == PointerEventKind.up) {
                                root.drag-finished();
                            }
                        }
                        moved => {
                            root.drag-moved();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16px; // px-4
                        padding-right: 16px;
                        padding-top: 12px; // py-3
                        padding-bottom: 12px;
                        spacing: Metrics.space-3;

                        // 输入控件容器（flex-1 rounded-md px-2）
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: Metrics.radius-md;
                            background: root.input-suspended ? Theme.canvas-subtle : transparent;

                            HorizontalLayout {
                                padding-left: Metrics.space-2;
                                padding-right: Metrics.space-2;
                                // 旧版 searchControl 无 gap：图标底座自带视觉
                                // 留白，分隔线靠 mx-1 自带边距
                                spacing: 0px;

                                // 放大镜（h-8 w-8 底座内 h-5 w-5 图形居中，
                                // 对齐旧版 svg：圆 r6.5@24viewbox → 20px 显示）
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    Rectangle {
                                        width: 10.8px;
                                        height: 10.8px;
                                        x: 10.6px;
                                        y: 10.6px;
                                        border-radius: Metrics.radius-pill;
                                        border-width: 1.5px;
                                        border-color: Theme.fg-muted;
                                    }
                                    Path {
                                        width: 32px;
                                        height: 32px;
                                        viewbox-width: 32;
                                        viewbox-height: 32;
                                        stroke: Theme.fg-muted;
                                        stroke-width: 1.5px;
                                        commands: "M 19.3 19.3 L 23.1 23.1";
                                    }
                                }

                                // 输入区（flex-1，17px/24px）
                                Rectangle {
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        search-input := TextInput {
                                            text <=> root.keyword;
                                            font-size: 17px;
                                            color: Theme.fg-default;
                                            // 选区与 IME 组合词同用这对颜色：
                                            // 缺省时走 Slint 硬编码蓝，与旧版 ::selection 不符
                                            selection-foreground-color: Theme.selection-fg;
                                            selection-background-color: Theme.selection-bg;
                                            single-line: true;
                                            enabled: !root.input-suspended;
                                            edited() => {
                                                root.keyword-edited(self.text);
                                            }
                                        }
                                    }
                                    // IME 组合期间 keyword 仍为空，但组合词已由
                                    // TextInput 画在框内：等预编辑清空再显示占位符，
                                    // 否则与组合词重叠（旧版浏览器组合开始即隐藏）
                                    if (root.keyword == "" && search-input.preedit-text == ""): Text {
                                        x: 0;
                                        width: parent.width;
                                        horizontal-alignment: left;
                                        text: root.input-suspended
                                            ? "键盘已交给速贴面板，按 Esc 返回" : "开始键入...";
                                        color: Theme.fg-subtle;
                                        font-size: 17px;
                                        vertical-alignment: center;
                                    }
                                }

                                // 清除按钮（h-7 w-7）。布局交叉轴对固定高子元素
                                // 是顶对齐：外层只定宽（交叉轴被拉伸），内层用
                                // 显式 y 在控制区内垂直居中
                                if (root.keyword != ""): Rectangle {
                                    width: 28px;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: 28px;
                                        height: 28px;
                                        border-radius: Metrics.radius-pill;
                                        background: clear-ta.has-hover ? Theme.canvas-subtle : transparent;
                                        clear-ta := TouchArea {
                                            clicked => {
                                                root.clear-keyword();
                                                search-input.focus();
                                            }
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.button-hint("清除关键词",
                                                        self.absolute-position.x,
                                                        self.absolute-position.y + self.height + 4px);
                                                } else {
                                                    root.button-hint-left();
                                                }
                                            }
                                        }
                                        Path {
                                            width: 16px;
                                            height: 16px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            viewbox-width: 24;
                                            viewbox-height: 24;
                                            stroke: clear-ta.has-hover
                                                ? Theme.fg-default : Theme.fg-subtle;
                                            stroke-width: 1.2px;
                                            commands: "M 6 6 L 18 18 M 18 6 L 6 18";
                                        }
                                    }
                                }

                                // 分隔线（旧版 searchFilterDivider mx-1 h-5：
                                // 左右各 4px 由 9px 包裹容器模拟；线高 20px 在
                                // 控制区内显式垂直居中）
                                Rectangle {
                                    width: 9px;
                                    Rectangle {
                                        x: 4px;
                                        y: (parent.height - 20px) / 2;
                                        width: 1px;
                                        height: 20px;
                                        background: Theme.border-subtle;
                                    }
                                }

                                // 条目计数（加载中隐藏）
                                if (root.show-result-count): Text {
                                    text: root.result-count + "/" + root.result-total + " 条";
                                    color: Theme.fg-subtle;
                                    font-size: Metrics.text-xs;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── 错误条（3 秒自动消失由 Rust 控制）──
                error-bar := Rectangle {
                    visible: root.error-text != "";
                    height: self.visible ? 36px : 0px;
                    background: Theme.danger-subtle;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.danger-fg.with-alpha(0.2);
                    }
                    HorizontalLayout {
                        padding-left: 20px; // px-5
                        padding-right: 20px;
                        Text {
                            text: root.error-text;
                            color: Theme.danger-fg;
                            font-size: Metrics.text-sm;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }

                // ── 筛选行（px-4 py-1.5 gap-1，全窗唯一分隔线）──
                filter-bar := Rectangle {
                    height: 36px;
                    // 透出 panel 的材质底
                    background: transparent;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                    filter-flick := Flickable {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        interactive: true;
                        HorizontalLayout {
                            padding-left: 16px; // px-4
                            padding-right: 16px;
                            padding-top: Metrics.space-1_5;
                            padding-bottom: Metrics.space-1_5;
                            spacing: Metrics.space-1;
                            alignment: start;

                            FilterChip {
                                label: "全部";
                                active: root.active-filter == 0;
                                clicked => { root.filter-selected(0); }
                            }
                            FilterChip {
                                label: "收藏";
                                active: root.active-filter == 1;
                                clicked => { root.filter-selected(1); }
                            }
                            FilterChip {
                                label: "文本";
                                active: root.active-filter == 2;
                                clicked => { root.filter-selected(2); }
                            }
                            FilterChip {
                                label: "图片";
                                active: root.active-filter == 3;
                                clicked => { root.filter-selected(3); }
                            }
                            FilterChip {
                                label: "文件";
                                active: root.active-filter == 4;
                                clicked => { root.filter-selected(4); }
                            }
                            if (root.tag-chips.length > 0): Rectangle {
                                // 旧版 filterRowDivider mx-1 h-4：左右各 4px
                                // 由 9px 包裹容器模拟
                                width: 9px;
                                height: 16px;
                                Rectangle {
                                    x: 4px;
                                    y: 0;
                                    width: 1px;
                                    height: parent.height;
                                    background: Theme.border-subtle;
                                }
                            }
                            for tag[i] in root.tag-chips: TagChip {
                                label: tag.name;
                                active: tag.active;
                                clicked => { root.tag-toggled(i); }
                            }
                        }
                    }
                }

                // ── 列表区（flex-1；四态共用同一 Flickable 保证实测高度）──
                Rectangle {
                    horizontal-stretch: 1;
                    // 无独立底色：与 header/footer/窗底完全同一透明语义，
                    // 透明程度天然一致；透出强度由材质 alpha 统一控制
                    background: transparent;
                    clip: true;

                    list-flick := Flickable {
                        x: 0;
                        y: 0;
                        width: parent.width - SearchGeometry.scroll-slot;
                        height: parent.height;
                        interactive: true;

                        function report-preview-widths() {
                            // 列表内容宽（扣双层包裹 padding）→ 行基础预览宽
                            //（扣行左强调边 2px + 左右 12px 内边距 + 图标列
                            // 36px + 列间距 12px；图标列对缩略图/类型图标恒占位）
                            root.preview-width-no-thumb =
                                self.width - 2 * SearchGeometry.content-pad-h
                                - SearchGeometry.row-border-l - 2 * SearchGeometry.row-pad-h
                                - SearchGeometry.thumb-size - SearchGeometry.thumb-gap;
                            root.preview-width-thumb = root.preview-width-no-thumb;
                        }
                        init => { self.report-preview-widths(); }
                        changed width => { self.report-preview-widths(); }

                        list-stack := VerticalLayout {
                            padding-top: SearchGeometry.content-pad-top;
                            padding-bottom: SearchGeometry.content-pad-bottom;
                            padding-left: SearchGeometry.content-pad-h;
                            padding-right: SearchGeometry.content-pad-h;
                            spacing: 0px;

                            // 内容自然高：viewport-height 有下限（不低于视口
                            // 自身），窗口收不高、也收不矮；高度同步改用布局
                            // 的首选/最小高（含 padding，行卡片均显式高度）
                            property <length> natural-height:
                                max(self.min-height, self.preferred-height);

                            if (root.loading): VerticalLayout {
                                min-height: 160px;
                                padding-top: 48px;
                                padding-bottom: 48px;
                                alignment: center;
                                Text {
                                    text: "加载中...";
                                    color: Theme.fg-muted;
                                    font-size: Metrics.text-sm;
                                    horizontal-alignment: center;
                                }
                            }

                            if (!root.loading && root.load-failed): VerticalLayout {
                                min-height: 160px;
                                padding-top: 48px;
                                padding-bottom: 48px;
                                alignment: center;
                                spacing: Metrics.space-1;
                                Text {
                                    text: "记录加载失败";
                                    color: Theme.fg-subtle;
                                    font-size: Metrics.text-sm;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.load-error-text;
                                    color: Theme.fg-subtle;
                                    font-size: Metrics.text-xs;
                                    horizontal-alignment: center;
                                }
                                Rectangle {
                                    height: 26px;
                                    border-radius: Metrics.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-default;
                                    background: retry-ta.has-hover ? Theme.canvas-subtle : transparent;
                                    retry-ta := TouchArea {
                                        clicked => { root.retry-clicked(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: "重试";
                                            color: Theme.fg-muted;
                                            font-size: Metrics.text-xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            if (!root.loading && !root.load-failed && root.rows.length == 0): VerticalLayout {
                                min-height: 160px;
                                padding-top: 48px;
                                padding-bottom: 48px;
                                alignment: center;
                                spacing: Metrics.space-1;
                                Text {
                                    text: root.empty-title;
                                    color: Theme.fg-subtle;
                                    font-size: Metrics.text-sm;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.empty-description;
                                    color: Theme.fg-subtle;
                                    font-size: Metrics.text-sm;
                                    horizontal-alignment: center;
                                }
                                if (root.empty-action != 0): Rectangle {
                                    height: 26px;
                                    border-radius: Metrics.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-default;
                                    background: empty-ta.has-hover ? Theme.canvas-subtle : transparent;
                                    empty-ta := TouchArea {
                                        clicked => {
                                            if (root.empty-action == 1) {
                                                root.clear-keyword();
                                            } else {
                                                root.clear-filters();
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: root.empty-action == 1 ? "清除关键词" : "清除筛选";
                                            color: Theme.fg-muted;
                                            font-size: Metrics.text-xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            if (!root.loading && !root.load-failed && root.rows.length > 0): VerticalLayout {
                                spacing: 0px;
                                for row[i] in root.rows: SearchRowCard {
                                    data: row;
                                    selected: i == root.selected;
                                    preview-width: root.preview-width-no-thumb;
                                    delete-armed: root.delete-armed-row == i;
                                    clicked => { root.row-clicked(i); }
                                    double-clicked => { root.row-double-clicked(i); }
                                    hover(x, y) => { root.row-hover(i, x, y); }
                                    hover-left => { root.row-hover-left(); }
                                    button-hint(t, x, y) => { root.button-hint(t, x, y); }
                                    button-hint-left => { root.button-hint-left(); }
                                    paste => { root.action-paste(i); }
                                    paste-as-path => { root.action-paste-as-path(i); }
                                    edit => { root.action-edit(i); }
                                    toggle-favorite => { root.action-toggle-favorite(i); }
                                    delete-armed-request => { root.action-delete(i); }
                                    scroll-into-view(row-y, row-height) => {
                                        if (row-y < -list-flick.viewport-y + 6px) {
                                            list-flick.viewport-y = -row-y + 6px;
                                        } else if (row-y + row-height > -list-flick.viewport-y + list-flick.height - 6px) {
                                            list-flick.viewport-y = -(row-y + row-height - list-flick.height + 6px);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 内容实测高变化上报（空态/加载态/行数变化都反映在
                    // 内容自然高上）
                    Rectangle {
                        visible: false;
                        property <length> observed-nh: list-stack.natural-height;
                        changed observed-nh => {
                            root.heights-changed();
                        }
                    }

                    // 触底预载：可视底部接近内容底部 240px 内时上报
                    Rectangle {
                        visible: false;
                        property <length> visible-bottom:
                            -list-flick.viewport-y + list-flick.height;
                        changed visible-bottom => {
                            if (root.has-next-page && list-flick.viewport-height > 0
                                && list-flick.viewport-height - self.visible-bottom
                                    < SearchGeometry.load-more-margin) {
                                root.near-bottom();
                            }
                        }
                    }

                    if (list-flick.viewport-height > list-flick.height): ListScrollBar {
                        x: parent.width - SearchGeometry.scroll-slot;
                        y: 0;
                        width: SearchGeometry.scroll-slot;
                        height: parent.height;
                        viewport-height: list-flick.viewport-height;
                        visible-height: list-flick.height;
                        viewport-y <=> list-flick.viewport-y;
                    }

                    // 会话打开滚回顶部
                    Rectangle {
                        visible: false;
                        property <int> generation: root.scroll-generation;
                        changed generation => {
                            list-flick.viewport-y = 0;
                        }
                    }
                }

                // ── 底栏键位提示 ──
                footer-bar := Rectangle {
                    height: 28px;
                    // 恒定半透明：材质时透 backdrop，无材质时叠窗底实色
                    background: Theme.canvas-subtle.with-alpha(0.6);
                    HorizontalLayout {
                        alignment: center;
                        spacing: Metrics.space-3;
                        if (!root.input-suspended): KeyHint { key: "↑↓"; label: "选择"; }
                        if (!root.input-suspended): KeyHint { key: "Enter"; label: "粘贴"; }
                        if (!root.input-suspended): KeyHint { key: "Ctrl+Enter"; label: "编辑"; }
                        if (!root.input-suspended): KeyHint { key: "Del"; label: "删除"; }
                        if (!root.input-suspended): KeyHint { key: "Esc"; label: "关闭"; }
                        if (root.input-suspended): KeyHint { key: "↑↓"; label: "选择"; }
                        if (root.input-suspended): KeyHint { key: "Enter"; label: "粘贴"; }
                        if (root.input-suspended): KeyHint { key: "1-9"; label: "直达"; }
                        if (root.input-suspended): KeyHint { key: "Esc"; label: "返回搜索"; }
                    }
                }
            }
        }
    }
}
